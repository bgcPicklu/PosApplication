@using PosApplication.Models;
@model PosApplication.Models.RegisterModel

<div style="margin-top: 90px;">
    <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
        <div class="panel panel-bd lobidisable">
            <div class="panel-heading">
                <div class="panel-title">
                    <h4>Create a New Account</h4>
                </div>
            </div>
            <div style="height: 97%; width: 100%; overflow: auto; padding: 0; margin: 0 auto; margin-left: 10px; margin-top: 10px;">
                @Html.AntiForgeryToken()
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                    <div class="row" style="margin-bottom:10px;">
                        <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                            @Html.Label("Unit Name :", new { @style = "font-size: 10px;" })
                        </div>
                        <div class="col-lg-9 col-md-9 col-sm-9 col-xs-9">
                            @Html.DropDownListFor(m => m.UnitID, new SelectList(DropDownListModel.GetActiveUnitName,"Value","Text","0"),new { @class = "form-control", @id = "UnitID" })
                        </div>
                    </div>
                </div>

                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                    <div class="row" style="margin-bottom:10px;">
                        <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                            @Html.Label("User Name :", new { @style = "font-size: 10px;" })
                        </div>
                        <div class="col-lg-9 col-md-9 col-sm-9 col-xs-9">
                            @Html.TextBoxFor(m => m.UserName, new { @class = "form-control", @id = "UserName" })
                        </div>
                    </div>
                </div>

                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                    <div class="row" style="margin-bottom:10px;">
                        <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                            @Html.Label("Password :", new { @style = "font-size: 10px;" })
                        </div>
                        <div class="col-lg-9 col-md-9 col-sm-9 col-xs-9">
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control", @id = "Password" })
                        </div>
                    </div>
                </div>

                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                    <div class="row" style="margin-bottom:10px;">
                        <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                            @Html.Label("Confirm Password :", new { @style = "font-size: 10px;" })
                        </div>
                        <div class="col-lg-9 col-md-9 col-sm-9 col-xs-9">
                            @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", @id = "ConfirmPassword" })
                        </div>
                    </div>
                </div>

                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                    <div class="row" style="margin-bottom:10px;">
                        <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                            @Html.Label("Account Type :", new { @style = "font-size: 10px;" })
                        </div>
                        <div class="col-lg-9 col-md-9 col-sm-9 col-xs-9">
                            @Html.DropDownListFor(m => m.AccountType, new SelectList(DropDownListModel.GetAccountType, "Value", "Text", "0"), new { @class = "form-control", @id = "AccountType" })
                        </div>
                    </div>
                </div>

                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                    <div class="row" style="margin-bottom:10px;">
                        <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                            @Html.Label("Status :", new { @style = "font-size: 10px;" })
                        </div>
                        <div class="col-lg-9 col-md-9 col-sm-9 col-xs-9">
                            @Html.DropDownListFor(m => m.Status, new SelectList(DropDownListModel.GetStatus, "Value", "Text", "0"), new { @class = "form-control", @id = "Status" })
                        </div>
                    </div>
                </div>

                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                    <div class="row" style="margin-bottom:10px;">
                        <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                        </div>
                        <div class="col-lg-9 col-md-9 col-sm-9 col-xs-9">
                            <input type="button" class="btn btn-primary pull-right" id="btnRegister" value="Register" style="margin-right: 25px;" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="userNameEdit" />

@section Scripts{
    @Scripts.Render("~/bundles/jqueryval")
    <script type="text/javascript">
        $(document).ready(function () {
            $('#ConfirmPassword').change(function (event) {
                if ($('#Password').val() != $('#ConfirmPassword').val()) {
                    $('#ConfirmPassword').notify("Password not matched!", "warn");
                    $('#ConfirmPassword').val('');
                    $('#ConfirmPassword').focus();
                }
            });

            function formCheck() {
                if ($('#UnitID').val() != "0") {
                    if ($('#UserName').val()) {
                        if ($('#Password').val()) {
                            if ($('#ConfirmPassword').val()) {
                                if ($('#AccountType').val() != "0") {
                                    if ($('#Status').val() != "0") {
                                        return true;
                                    }
                                    else {
                                        $('#Status').notify("Please select status!", "warn");
                                        $('#Status').focus();
                                        return false;
                                    }
                                }
                                else {
                                    $('#AccountType').notify("Please select account type!", "warn");
                                    $('#AccountType').focus();
                                    return false;
                                }
                            }
                            else {
                                $('#ConfirmPassword').notify("Please provide confirm password!", "warn");
                                $('#ConfirmPassword').focus();
                                return false;
                            }
                        }
                        else {
                            $('#Password').notify("Please provide password!", "warn");
                            $('#Password').focus();
                            return false;
                        }
                    }
                    else {
                        $('#UserName').notify("Please provide username!", "warn");
                        $('#UserName').focus();
                        return false;
                    }
                }
                else {
                    $('#UnitID').notify("Please select unit!", "warn");
                    $('#UnitID').focus();
                    return false;
                }
            }

            $('#btnRegister').click(function () {
                if (formCheck())
                {
                    bootbox.confirm("Do you want to save this information?", function (result) {
                        if (result) {

                            $.ajax({
                                url: '@Url.Action("Create","Register")',
                                type: "POST",
                                data: { UnitID: $('#UnitID').val(), UserName: $('#UserName').val(), Password: $('#Password').val(), ConfirmPassword: $('#ConfirmPassword').val(), AccountType: $('#AccountType').val(), Status: $('#Status').val() },
                                success: function (data) {
                                    if (data.success) {
                                        $.notify(data.message, "success");
                                        window.setTimeout(function(){window.location.href = '@Url.Action("Create","Register")'}, 1000);
                                    }
                                    else
                                        $(data.message, "error");
                                }
                            });
                        }
                    });
                }
            });
        });
    </script>
}
