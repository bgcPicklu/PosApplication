@using PosApplication.Models;
@model PosApplication.Models.SalesMasterModel
<div style="margin-top: 90px;">
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12" style="margin: auto;">
        <div class="panel panel-bd lobidisable">
            <div class="panel-heading">
                <div class="panel-title">
                    <h4>Sales Return</h4>
                </div>
            </div>
            <div style="height:97%; width:100%; overflow:auto; padding:0; margin:0 auto; margin-left:10px; margin-top:10px;">
                @Html.AntiForgeryToken()
                <input type="button" id="btnFind" value="Find" class="btn btn-primary" />
                <hr />
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" style="margin-top:10px;">
                    <div class="row">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" style="margin-top:10px;">
                            <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                <div class="row">
                                    <div class="col-lg-2 col-md-2 col-sm-4 col-xs-4">
                                        @Html.Label("Invoice No:", new { @class = "control-label", @style = "font-size:10px;" })
                                    </div>
                                    <div class="col-lg-8 col-md-8 col-sm-8 col-xs-8">
                                        @Html.DropDownListFor(model => model.vInvoiceNo, new SelectList(DropDownListModel.GetReceivedInvoiceNo, "Value", "Text", "0"), new { @class = "form-control", @id = "InvoiceNo" })
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                <div class="row">
                                    <div class="col-lg-2 col-md-2 col-sm-4 col-xs-4">
                                        @Html.Label("Sales Date:", new { @class = "control-label", @style = "font-size:10px;" })
                                    </div>
                                    <div class="col-lg-8 col-md-8 col-sm-8 col-xs-8">
                                        @Html.TextBoxFor(model => model.dInvoiceDate, new { @class = "form-control", @id = "InvoiceDate", @readonly = "readonly", @style = "background: #fff;" })
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" style="margin-top:10px;">
                    <div class="row">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" style="margin-top:10px;">
                            <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                <div class="row">
                                    <div class="col-lg-2 col-md-2 col-sm-4 col-xs-4">
                                        @Html.Label("Sold By:", new { @class = "control-label", @style = "font-size:10px;" })
                                    </div>
                                    <div class="col-lg-8 col-md-8 col-sm-8 col-xs-8">
                                        @Html.TextBoxFor(model => model.vSoldBy, new { @class = "form-control", @id = "SoldBy", @readonly = "readonly", @style = "background: #fff;" })
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                <div class="row">
                                    <div class="col-lg-2 col-md-2 col-sm-4 col-xs-4">
                                        @Html.Label("Receiver Name:", new { @class = "control-label", @style = "font-size:10px;" })
                                    </div>
                                    <div class="col-lg-8 col-md-8 col-sm-8 col-xs-8">
                                        @Html.TextBoxFor(model => model.vReceiverName, new { @class = "form-control", @id = "ReceiverName", @readonly = "readonly", @style = "background: #fff;" })
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" style="margin-top:10px;">
                    <div class="row" style="max-height: 500px; overflow: auto;">
                        <table class="table table-responsive table-striped table-bordered table-hover table-condensed" id="tbProduct" style="width: 98%;">
                            <thead style="background: #1088b9; color: white;">
                                <tr>
                                    <th style="display: none; font-size: 8px;">Product ID</th>
                                    <th style="text-align: center; width: 18%; font-size: 8px;">Product Name</th>
                                    <th style="text-align: center; width: 4%; font-size: 8px;">Pack</th>
                                    <th style="text-align: center; width: 6%; font-size: 8px;">Max Qty</th>
                                    <th style="text-align: center; width: 6%; font-size: 8px;">Min Qty</th>
                                    <th style="text-align: center; width: 6%; font-size: 8px;">C.Stock</th>
                                    <th style="text-align: center; width: 6%; font-size: 8px; ">LU Qty.</th>
                                    <th style="text-align: center; width: 6%; font-size: 8px;">SU Qty.</th>
                                    <th style="text-align: center; width: 6%; font-size: 8px;">Total Qty.</th>
                                    <th style="text-align: center; width: 6%; font-size: 8px; ">Return Qty.</th>
                                    <th style="text-align: center; width: 5%; font-size: 8px;">P.Rate</th>
                                    <th style="text-align: center; width: 5%; font-size: 8px;">S.Rate</th>
                                </tr>
                            </thead>
                            <tfoot>
                                <tr>
                                    <td colspan="11" style="width: 100%; text-align: right; font-size: 10px;"></td>
                                </tr>
                            </tfoot>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>

                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" style="margin-top:10px;">
                    <div class="row" style="margin-top: 5px; margin-bottom: 5px;">
                        <div class="col-sm-4 col-xs-2"></div>
                        <div class="col-sm-2 col-xs-4">
                            <input type="button" value="Submit" id="btnSubmit" class="btn btn-success" style="width: 99%; max-width: 70px; float: right; font-size: 12px;" />
                        </div>
                        <div class="col-sm-2 col-xs-4">
                            <input type="button" value="Reset" id="btnReset" class="btn btn-success" style="width: 99%; max-width: 70px; float: left; font-size: 12px;" />
                        </div>
                    </div>
                </div>
                <div></div>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script type="text/javascript">
        $('#InvoiceNo').change(function () {
            var date = $('#InvoiceDate').val();
            var ReferenceNo = $('#ReferenceNo').val();
            debugger;
            $('#tbProduct tbody').empty();
            var tableData = [];
            dupProduct = [];
            var total_Amount = 0.0;
            $.ajax({
                url: '@Url.Action("getSalesReceivedData", "SalesInformation")',
                data: { dDate: date, ReferenceNo: ReferenceNo, vChallanNo: $('#InvoiceNo').val() },
                type: 'GET',
                success: function (data) {
                    $('#InvoiceDate').val(data.masterData.dInvoiceDate);
                    $('#InvoiceNo').val(data.masterData.vChallanNo);
                    $('#SoldBy').val(data.masterData.vSoldBy);
                    $('#ReceiverName').val(data.masterData.vReceiverName);
                    tableData = data.detailData;
                    $.each(tableData, function (i, value) {
                        dupProduct.push(value.vProductID);
                        $('#tbProduct').append('<tr id = "mainRow">' +
                    '<td style="display: none; font-size: 10px;" class="ProductID">' + value.vProductID + '</td>' +
                    '<td style="font-size: 10px;" class="ProductName">' + value.vProductName + '</td>' +
                    '<td style="font-size: 10px;" class="packName">' + value.vPackSize + '</td>' +
                    '<td style="font-size: 10px; text-align: right;" class="MaxQty">' + value.mMaxQty + '</td>' +
                    '<td style="font-size: 10px; text-align: right;" class="MinQty">' + value.mMinQty + '</td>' +
                    '<td style="font-size: 10px; text-align: right;" class="currentStock">' + value.mCurrentStock + '</td>' +
                    '<td style="font-size: 10px; text-align: right;" class="luQty">' + value.mLuQty + '</td>' +
                    '<td style="font-size: 10px; text-align: right;" class="suQty">' + value.mSuQty + '</td>' +
                    '<td style="font-size: 10px; text-align: right;" class="totalQty">' + ((parseFloat(value.mLuQty) * parseFloat(value.mMaxQty) * parseFloat(value.mMinQty)) + parseFloat(value.mSuQty)).toFixed(2) + '</td>' +
                    '<td style="font-size: 10px; text-align: right;"><input type = "text" id = "ReturnQty' + i + '" class = "form-control" style = "text-align: right;"/></td>' +
                    '<td style="font-size: 10px; text-align: right;" class="PurchaseRate">' + value.mPurchaseRate + '</td>' +
                    '<td style="font-size: 10px; text-align: right;" class="SalesRate">' + value.mSalesRate + '</td></tr>');
                    });
                }
            });

            $('#SupplierId').prop('disabled', false);
            $('#PackId').prop('disabled', false);
            $('#productID').prop('disabled', false);
            $('#luQty').prop('disabled', false);
            $('#suQty').prop('disabled', false);
        });

        var lstData = [];
        $('#btnSubmit').click(function () {
            var ret = false;
            debugger;
            $('#tbProduct tbody').find('tr').each(function (i, value) {
                var $td = $(this).find('td');
                if (!isNaN(parseFloat($('#ReturnQty' + i).val()))) {
                    lstData.push({ vProductID: $td.eq(0).text(), mReturnSalesQty: $('#ReturnQty' + i).val() });
                    ret = true;
                }
            });

            if (ret)
            {
                bootbox.confirm('Do you want to save this information?', function (result) {
                    if (result) {
                        $.ajax({
                            url: '@Url.Action("SalesReturn", "SalesInformation")',
                            type: "POST",
                            data: JSON.stringify({ vInvoiceNo: $('#InvoiceNo').val(), lstSalesDetails: lstData }),
                            dataType: "JSON",
                            contentType: 'application/json',
                            success: function (response) {
                                if (response.success) {
                                    $.notify(response.message, "success");
                                    window.setTimeout(function () { window.location.href = '@Url.Action("SalesReturn", "SalesInformation")' }, 1000);
                                }
                                else {
                                    $.notify(response.message, "error");
                                }
                            }
                        });
                    }
                });
            }
            else {
                $.notify("No Data found!!!", "error");
            }
        });
    </script>
}
