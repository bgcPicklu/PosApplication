                $('#tbProduct tbody').find('tr').each(function (i, event) {
                    var $tdValue = $(this).find('td');
                    $tdValue.eq(9).text(((vatPercentage * parseFloat($tdValue.eq(8).text())) / 100).toFixed(2));
                    $tdValue.eq(10).text((parseFloat($tdValue.eq(9).text()) + parseFloat($tdValue.eq(8).text())).toFixed(2));
                    $tdValue.eq(12).text((parseFloat($tdValue.eq(10).text()) - parseFloat($tdValue.eq(11).text())).toFixed(2));
                    $tdValue.eq(13).text((parseFloat($tdValue.eq(12).text()) / ((parseFloat($tdValue.eq(6).text()) * parseFloat($tdValue.eq(3).text()) * parseFloat($tdValue.eq(4).text())) + parseFloat($tdValue.eq(7).text()))).toFixed(2));
                });
            }

