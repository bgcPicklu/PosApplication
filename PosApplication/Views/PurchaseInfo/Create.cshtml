@using PosApplication.Models;
@model PosApplication.Models.PurchaseMasterModel
<div style="margin-top: 90px;">
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12" style="margin: auto;">
        <div class="panel panel-bd lobidisable">
            <div class="panel-heading">
                <div class="panel-title">
                    <h4>Purchase Information</h4>
                </div>
            </div>
            <div style="height:97%; width:100%; overflow:auto; padding:0; margin:0 auto; margin-left:10px; margin-top:10px;">
                @Html.AntiForgeryToken()
                <input type="button" id="btnFind" value="Find" class="btn btn-primary" />
                <hr />
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" style="margin-top:10px;">
                    <div class="row">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" style="margin-top:10px;">
                            <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                <div class="row">
                                    <div class="col-lg-4 col-md-4 col-sm-4 col-xs-4">
                                        @Html.Label("Purchase Date:", new { @class = "control-label", @style = "font-size:10px;" })
                                    </div>
                                    <div class="col-lg-8 col-md-8 col-sm-8 col-xs-8">
                                        @Html.TextBoxFor(model => model.dPurchaseDate, new { @class = "form-control", @id = "PurchaseDate", @readonly = "readonly", @style = "background: #fff;" })
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                <div class="row">
                                    <div class="col-lg-4 col-md-4 col-sm-4 col-xs-4">
                                        @Html.Label("Receive No:", new { @class = "control-label", @style = "font-size:10px;" })
                                    </div>
                                    <div class="col-lg-8 col-md-8 col-sm-8 col-xs-8">
                                        @Html.TextBoxFor(model => model.vReferenceNo, new { @class = "form-control", @id = "ReferenceNo", @readonly = "readonly", @style = "background: #fff;" })
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                <div class="row">
                                    <div class="col-lg-4 col-md-4 col-sm-4 col-xs-4">
                                        @Html.Label("Bill/Challan No:", new { @class = "control-label", @style = "font-size:10px;" })
                                    </div>
                                    <div class="col-lg-8 col-md-8 col-sm-8 col-xs-8">
                                        @Html.TextBoxFor(model => model.vChallanNo, new { @class = "form-control", @id = "ChallanNo" })
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" style="margin-top:10px;">
                    <div class="row">
                        <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                            <div class="row">
                                <div class="col-lg-4 col-md-4 col-sm-4 col-xs-4">
                                    @Html.Label("Payment Type :", new { @class = "control-label", @style = "font-size:10px;" })
                                </div>
                                <div class="col-lg-8 col-md-8 col-sm-8 col-xs-8">
                                    @Html.DropDownListFor(model => model.vPaymentType, new SelectList(DropDownListModel.GetPaymentMethod, "Value", "Text", "Cash"), new { @class = "form-control", @id = "paymentMethod", @style = "text-align: right;" })
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                            <div class="row">
                                <div class="col-lg-4 col-md-4 col-sm-4 col-xs-4">
                                    @Html.Label("Account/Cheque No :", new { @class = "control-label", @style = "font-size:10px;" })
                                </div>
                                <div class="col-lg-8 col-md-8 col-sm-8 col-xs-8">
                                    @Html.TextBoxFor(model => model.vAccount_ChequeNo, new { @class = "form-control", @id = "accountNo", @style = "text-align: right;" })
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                            <div class="row">
                                <div class="col-lg-4 col-md-4 col-sm-4 col-xs-4">
                                    @Html.Label("Bank Name :", new { @class = "control-label", @style = "font-size:10px;" })
                                </div>
                                <div class="col-lg-8 col-md-8 col-sm-8 col-xs-8">
                                    @Html.TextBoxFor(model => model.vBankName, new { @class = "form-control", @id = "bankName", @style = "text-align: right;" })
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" style="margin-top: 10px;">

                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                    <div class="row">
                                        <div class="col-lg-4 col-md-4 col-sm-4 col-xs-4">
                                            @Html.Label("VAT(%):", new { @class = "control-label", @style = "font-size:10px;" })
                                        </div>
                                        <div class="col-lg-8 col-md-8 col-sm-8 col-xs-8">
                                            @Html.TextBoxFor(model => model.mVatPercent, new { @class = "form-control", @id = "VATPercentage", @style = "text-align: right;" })
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-7 col-md-7 col-sm-12 col-xs-12">
                                </div>

                                <div class="col-lg-1 col-md-1 col-sm-12 col-xs-12">
                                    <div class="row">
                                        <div class="col-lg-1 col-md-1 col-sm-1 col-xs-1">
                                            <input type="button" value="Proceed" class="btn btn-primary pull-left" id="btnProceed" style="font-size: 12px;" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" style="margin-top:20px;">
                            <div class="col-lg-7 col-md-7 col-sm-12 col-xs-12">
                                <div class="row">
                                    <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                                        @Html.Label("Supplier Name:", new { @class = "control-label", @style = "font-size:10px;" })
                                    </div>
                                    <div class="col-lg-9 col-md-9 col-sm-9 col-xs-9">
                                        @Html.DropDownListFor(model => model.vSupplierID, new SelectList(DropDownListModel.GetSupplier, "Value", "Text", "0"), new { @class = "form-control", @id = "SupplierId", @disabled = true })
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                <div class="row">
                                    <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                                        @Html.Label("Pack Size:", new { @class = "control-label", @style = "font-size:10px;" })
                                    </div>
                                    <div class="col-lg-9 col-md-9 col-sm-9 col-xs-9">
                                        @Html.DropDownListFor(model => model.vPackID, new SelectList(DropDownListModel.GetPackSize, "Value", "Text", "0"), new { @class = "form-control", @id = "PackId", @disabled = true })
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" style="margin-top:10px;">
                    <div class="row" style="max-height: 500px; overflow: auto;">
                        <table class="table table-responsive table-striped table-bordered table-hover table-condensed" style="width: 98%;">
                            <thead style="background: #1088b9; color: white;">
                                <tr>
                                    <th style="text-align: center; width: 23%; font-size: 8px;">Product Name</th>
                                    <th style="text-align: center; width: 4%; font-size: 8px;">Pack</th>
                                    <th style="text-align: center; width: 6%; font-size: 8px;">Max Qty</th>
                                    <th style="text-align: center; width: 6%; font-size: 8px;">Min Qty</th>
                                    <th style="text-align: center; width: 6%; font-size: 8px;">C.Stock</th>
                                    <th style="text-align: center; width: 6%; font-size: 8px; ">LU Qty.</th>
                                    <th style="text-align: center; width: 6%; font-size: 8px;">SU Qty.</th>
                                    <th style="text-align: center; width: 6%; font-size: 8px; ">Amount</th>
                                    <th style="text-align: center; width: 5%; font-size: 8px;">VAT</th>
                                    <th style="text-align: center; width: 6%; font-size: 8px; ">VAT+Amt.</th>
                                    <th style="text-align: center; width: 5%; font-size: 8px; ">Discount</th>
                                    <th style="text-align: center; width: 8%; font-size: 8px;">Total Net Amt.</th>
                                    <th style="text-align: center; width: 5%; font-size: 8px; ">P.Rate</th>
                                    <th style="text-align: center; width: 5%; font-size: 8px;">S.Rate</th>
                                    <th style="width: 3%; font-size: 10px;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td style="width: 23%;">
                                        <select id="productID" class="form-control" disabled="disabled">
                                            <option>--Select--</option>
                                        </select>
                                    </td>
                                    <td style="width: 4%;">
                                        <label id="packName" style="font-size: 10px; font-weight:normal; text-align:right; width: 100%;"></label>
                                    </td>
                                    <td style="width: 6%;">
                                        <label id="MaxQty" style="font-size: 10px; font-weight: normal; text-align: right; width: 100%; "></label>
                                    </td>
                                    <td style="width: 6%;">
                                        <label id="MinQty" style="font-size: 10px; font-weight: normal; text-align: right; width: 100%; "></label>
                                    </td>
                                    <td style="width: 5%;">
                                        <label id="currentStock" style="font-size: 10px; font-weight: normal; text-align: right; width: 100%; "></label>
                                    </td>
                                    <td style="width: 6%;">
                                        <input type="text" id="luQty" class="form-control" disabled="disabled" style="text-align: right; margin-right: 20%;" />
                                    </td>
                                    <td style="width: 6%;">
                                        <input type="text" id="suQty" class="form-control" disabled="disabled" style="text-align: right; margin-right: 20%;" />
                                    </td>
                                    <td style="width: 6%;">
                                        <input type="text" id="vAmount" class="form-control" disabled="disabled" style="text-align: right; margin-right: 20%;" />
                                    </td>
                                    <td style="width: 6%;">
                                        <label id="vat" style="font-size: 10px; font-weight: normal; text-align: right; width: 100%; "></label>
                                    </td>
                                    <td style="width: 5%;">
                                        <label id="vatAmount" style="font-size: 10px; font-weight: normal; text-align: right; width: 100%; "></label>
                                    </td>
                                    <td style="width: 6%;">
                                        <input type="text" id="discount" class="form-control" disabled="disabled" style="text-align: right; margin-right: 20%;" />
                                    </td>
                                    <td style="width: 5%;">
                                        <label id="totalNetAmount" style="font-size: 10px; font-weight: normal; text-align: right; width: 100%; "></label>
                                    </td>
                                    <td style="width: 8%;">
                                        <label id="purchaseRate" style="font-size: 10px; font-weight: normal; text-align: right; width: 100%; "></label>
                                    </td>
                                    <td style="width: 5%;">
                                        <label id="SalesRate" style="font-size: 10px; font-weight: normal; text-align: right; width: 100%; "></label>
                                    </td>
                                    <td style="width: 3%;">
                                        <input type="button" class="btn btn-success" value="Add" id="btnAddEdit" style="width: 60px; float: right; font-size: 12px;" />
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" style="margin-top:10px;">
                    <div class="row" style="max-height: 500px; overflow: auto;">
                        <table class="table table-responsive table-striped table-bordered table-hover table-condensed" id="tbProduct" style="width: 98%;">
                            <thead style="background: #1088b9; color: white;">
                                <tr>
                                    <th style="display: none; font-size: 8px;">Product ID</th>
                                    <th style="text-align: center; width: 14%; font-size: 8px;">Product Name</th>
                                    <th style="text-align: center; width: 4%; font-size: 8px;">Pack</th>
                                    <th style="text-align: center; width: 6%; font-size: 8px;">Max Qty</th>
                                    <th style="text-align: center; width: 6%; font-size: 8px;">Min Qty</th>
                                    <th style="text-align: center; width: 6%; font-size: 8px;">C.Stock</th>
                                    <th style="text-align: center; width: 6%; font-size: 8px; ">LU Qty.</th>
                                    <th style="text-align: center; width: 6%; font-size: 8px;">SU Qty.</th>
                                    <th style="text-align: center; width: 6%; font-size: 8px; ">Amount</th>
                                    <th style="text-align: center; width: 5%; font-size: 8px;">VAT</th>
                                    <th style="text-align: center; width: 6%; font-size: 8px; ">VAT+Amt.</th>
                                    <th style="text-align: center; width: 5%; font-size: 8px; ">Discount</th>
                                    <th style="text-align: center; width: 8%; font-size: 8px;">Total Net Amt.</th>
                                    <th style="text-align: center; width: 4%; font-size: 8px; ">P.Rate</th>
                                    <th style="text-align: center; width: 4%; font-size: 8px;">S.Rate</th>
                                    <th style="width: 14%; font-size: 10px;"></th>
                                </tr>
                            </thead>
                            <tfoot>
                                <tr>
                                    <td colspan="7" style="width: 100%; text-align: right; font-size: 10px;">Total = </td>
                                    <td><label id="totalAmount" style="text-align: right; width: 100%; font-size: 10px;"></label></td>
                                    <td><label id="totalVAT" style="text-align: right; width: 100%; font-size: 10px;"></label></td>
                                    <td><label id="totalVATWithAmount" style="text-align: right; width: 100%; font-size: 10px;"></label></td>
                                    <td><label id="totalDiscountAmount" style="text-align: right; width: 100%; font-size: 10px;"></label></td>
                                    <td><label id="totalAmountValue" style="text-align: right; width: 100%; font-size: 10px;"></label></td>
                                    <td colspan="3"></td>
                                </tr>
                            </tfoot>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>

                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                    <div class="row" style="margin-top: 5px; margin-bottom: 5px;">
                        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                        </div>

                        <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                            <div class="row">
                                <div class="col-lg-4 col-md-4 col-sm-4 col-xs-4">
                                    @Html.Label("Previous Dues:", new { @class = "control-label", @style = "font-size:10px; text-align: right; width: 100%;" })
                                </div>
                                <div class="col-lg-7 col-md-7 col-sm-8 col-xs-8">
                                    @Html.TextBoxFor(model => model.mPreviousDues, new { @class = "form-control", @id = "PreviousDues", @style = "text-align: right; background:#fff;", @readonly = "readonly" })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                    <div class="row" style="margin-top: 5px; margin-bottom: 5px;">
                        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                            <div class="row">
                                <div class="col-lg-4 col-md-4 col-sm-4 col-xs-4">
                                    @Html.Label("VAT Amount:", new { @class = "control-label", @style = "font-size:10px;" })
                                </div>
                                <div class="col-lg-8 col-md-8 col-sm-8 col-xs-8">
                                    @Html.TextBoxFor(model => model.mTotalVatAmount, new { @class = "form-control", @id = "TotalVatAmount", @style = "text-align: right;" })
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                            <div class="row">
                                <div class="col-lg-4 col-md-4 col-sm-4 col-xs-4">
                                    @Html.Label("Total Dues:", new { @class = "control-label", @style = "font-size:10px; text-align: right; width: 100%;" })
                                </div>
                                <div class="col-lg-7 col-md-7 col-sm-8 col-xs-8">
                                    <input type="text" id="totalDues" style="text-align:right; background:#fff;" class="form-control" readonly="readonly" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                    <div class="row" style="margin-top: 5px; margin-bottom: 5px;">
                        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                            <div class="row">
                                <div class="col-lg-4 col-md-4 col-sm-4 col-xs-4">
                                    @Html.Label("Discount Amount:", new { @class = "control-label", @style = "font-size:10px;" })
                                </div>
                                <div class="col-lg-8 col-md-8 col-sm-8 col-xs-8">
                                    @Html.TextBoxFor(model => model.mTotalDiscount, new { @class = "form-control", @id = "totalDiscount", @style = "text-align: right;" })
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                            <div class="row">
                                <div class="col-lg-4 col-md-4 col-sm-4 col-xs-4">
                                    @Html.Label("Paid Amount:", new { @class = "control-label", @style = "font-size:10px; text-align: right; width: 100%;" })
                                </div>
                                <div class="col-lg-7 col-md-7 col-sm-8 col-xs-8">
                                    @Html.TextBoxFor(model => model.mPaidAmount, new { @class = "form-control", @id = "PaidAmount", @style = "text-align: right;" })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                    <div class="row" style="margin-top: 5px; margin-bottom: 5px;">
                        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                        </div>

                        <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                            <div class="row">
                                <div class="col-lg-4 col-md-4 col-sm-4 col-xs-4">
                                    @Html.Label("Dues:", new { @class = "control-label", @style = "font-size:10px; text-align: right; width: 100%;" })
                                </div>
                                <div class="col-lg-7 col-md-7 col-sm-8 col-xs-8">
                                    <input type="text" id="NetDues" style="text-align: right; background: #fff;" class="form-control" readonly = "readonly" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" style="margin-top:10px;">
                    <div class="row" style="margin-top: 5px; margin-bottom: 5px;">
                        <div class="col-sm-4 col-xs-2"></div>
                        <div class="col-sm-2 col-xs-4">
                            <input type="button" value="Submit" id="btnSubmit" class="btn btn-success" style="width: 99%; max-width: 70px; float: right; font-size: 12px;" />
                        </div>
                        <div class="col-sm-2 col-xs-4">
                            <input type="button" value="Reset" id="btnReset" class="btn btn-success" style="width: 99%; max-width: 70px; float: left; font-size: 12px;" />
                        </div>
                    </div>
                </div>
                <div></div>
            </div>
        </div>
    </div>
</div>
    @Html.HiddenFor(model => model.vReferenceNoAuto, new { @id = "vReferenceNoAuto" })
    @section Scripts{
        <script src="~/Scripts/PurchaseInfo_Script.js"></script>
        <script type="text/javascript">
            $('#PurchaseDate').datepicker({
                dateFormat: 'dd-mm-yy',
                showStatus: true,
                showWeeks: true,
                changeMonth: true,
                changeYear: true,
                showButtionPanel: true,
                highlightWeek: true,
                autoclose: true,
                onSelect: function (dateText) {
                    $(this).change();
                }
            }).on('change', function () {
                $.ajax({
                    url: '@Url.Action("getReferenceNo","PurchaseInfo")',
                    type: 'GET',
                    data: { dDate: $(this).val() },
                    success: function (data) {
                        $('#ReferenceNo').val(data.vReferenceNo);
                    }
                });
            });

            var productName = [];
            var dupProduct = [];

            function loadProductName(element) {
                debugger;
                var supplierID = $('#SupplierId').val();
                //if (supplierID == 0)
                //    supplierID = '%';
                var packID = $('#PackId').val();
                if (packID == 0)
                    packID = '%';
                $.ajax({
                    url: '@Url.Action("GetAllProduct", "PurchaseInfo")',
                    type: "GET",
                    data: { supplierID: supplierID, packID: packID },
                    success: function (data) {
                        productName = data;
                        renderProductName(element, productName);
                    }
                });
            }

            $('#paymentType').change(function () {
                if($('#paymentType').val() == 'Çheque'){
                    $('#bankName').show();
                }
                else {
                    $('#bankName').hide();
                }
            });

            @*$('#ChallanNo').change(function () {
                if ($('#vReferenceNoAuto').val().length > 0)
                {
                    $.ajax({
                        url: '@Url.Action("checkBillNo","PurchaseInfo")',
                        type: 'POST',
                        data: { challanNo: $(this).val(), referenceNo: $('#ReferenceNo').val() },
                        success: function (data) {
                            if (data.success) {
                                $('#ChallanNo').val('');
                                $('#ChallanNo').notify("Bill No. already exists!", "warn");
                            }
                        }
                    });
                }
            });*@

            function loadPreviousDues() {
                debugger;
                var vSupplierID = $('#SupplierId').val();
                $.ajax({
                    url: '@Url.Action("getPreviousDues", "PurchaseInfo")',
                    type: "GET",
                    data: { vSupplierID: vSupplierID },
                    success: function (data) {
                        $('#PreviousDues').val(isNaN(parseFloat(data.nPreviousDues)) ? 0.00 : data.nPreviousDues);
                    }
                });
            }

            function totalCalculation() {
                var previousDues = 0.0;
                if(!isNaN($('#PreviousDues').val()))
                    previousDues = parseFloat($('#PreviousDues').val());

                var amount = 0.0;
                if (!isNaN(parseFloat($('#totalAmountValue').text())))
                    amount = parseFloat($('#totalAmountValue').text());
                $('#totalDues').val((previousDues + amount).toFixed(2));
            }

            $('#SupplierId').change(function () {
                loadProductName($('#productID'));
                loadPreviousDues();
                totalCalculation();
            });

            $('#PackId').change(function () {
                loadProductName($('#productID'));
            });

            $('#btnReset').click(function () {
                window.location.href = '@Url.Action("Create", "PurchaseInfo")';
            });

            $('#PaidAmount').change(function () {
                if (isNaN(parseFloat($(this).val())))
                    $(this).val('0');
                $('#NetDues').val((parseFloat($('#totalDues').val()) - parseFloat($(this).val())).toFixed(2));
            });

            $('#productID').change(function () {
                debugger;
                //$('#SupplierId').val('0');
                $('#packName').text('');
                $('#MaxQty').text('');
                $('#MinQty').text('');
