            function validityCheck() {
                var validity = false;
                if($('#PurchaseDate').val()){
                    if ($('#ChallanNo').val()) {
                        if ($('#accountNo').val()) {
                            if ($('#paymentType').val() == 'Cheque') {
                                if ($('#bankName').val()) {
                                    $('#tbProduct tbody').find('tr').each(function (i, event) {
                                        var $td = $(this).find('td');
                                        if (parseFloat($td.eq(13).text()) < parseFloat($td.eq(14).text())) {
                                            validity = true;
                                        }
                                        else {
                                            $.notify('Please check purchase rate & sale rate!', 'warn');
                                            validity = false;
                                        }
                                    });
                                } else {
                                    $('#bankName').notify('Please provide bank name!', 'warn');
                                    $('#bankName').focus();
                                    validity = false;
                                }
                            }
                            else {
                                $('#tbProduct tbody').find('tr').each(function (i, event) {
                                    var $td = $(this).find('td');
                                    if (parseFloat($td.eq(13).text()) < parseFloat($td.eq(14).text())) {
                                        validity = true;
                                    }
                                    else {
                                        $.notify('Please check purchase rate & sale rate!', 'warn');
                                        validity = false;
                                    }
                                });
                            }
                        } else {
                            $('#accountNo').notify('Please provide account/cheque No.!', 'warn');
                            $('#accountNo').focus();
                            validity = false;
                        }
                    } else {
                        $('#ChallanNo').notify('Please provide bill/challan no.!', 'warn');
                        $('#ChallanNo').focus();
                        validity = false;
                    }
                } else {
                    $('#PurchaseDate').notify('Please provide purchase data!','warn');
                    $('#PurchaseDate').focus();
                    validity = false;
                }
                return validity;
            }

