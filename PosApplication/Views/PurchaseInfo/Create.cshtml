            function purchaseRateCalculation() {
                var luQty = 0.0;
                var suQty = 0.0;
                var amount = 0.0;
                var discount = 0.0;
                var vatPercentage = 0.0;
                if (!isNaN(parseFloat($('#luQty').val()))) {
                    luQty = parseFloat($('#luQty').val());
                }
                if (!isNaN(parseFloat($('#suQty').val()))) {
                    suQty = parseFloat($('#suQty').val());
                }
                if (!isNaN(parseFloat($('#discount').val()))) {
                    discount = parseFloat($('#discount').val());
                }
                if (!isNaN(parseFloat($('#vAmount').val()))) {
                    amount = parseFloat($('#vAmount').val());
                }
                if (!isNaN(parseFloat($('#VATPercentage').val()))) {
                    vatPercentage = parseFloat($('#VATPercentage').val());
                }
                if (luQty == 0 && suQty == 0) {
                    $('#vAmount').val('');
                }
                else
                {
                    $('#vat').text(((amount * vatPercentage) / 100).toFixed(2));
                    amount += parseFloat($('#vat').text());
                    $('#vatAmount').text(amount);
                    $('#totalNetAmount').text((amount - discount).toFixed(2));
                    $('#purchaseRate').text(((amount - discount) / ((luQty * (parseFloat($('#MaxQty').text()) * parseFloat($('#MinQty').text()))) + suQty)).toFixed(3));
                }
            }

            function purchaseRateMainTable() {
                var vatPercentage = 0.0;
