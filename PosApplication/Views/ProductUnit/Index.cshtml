@model IEnumerable<PosApplication.Models.ProductUnitModel>


<div style="margin-top: 90px;">
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
        <div class="panel panel-bd lobidisable">
            <div class="panel-heading">
                <div class="panel-title">
                    <h4>Product Unit Information</h4>
                </div>
            </div>
            <div style="height:97%; width:100%; overflow:auto; padding:0; margin:0 auto; margin-left:10px; margin-top:10px;">
                @Html.AntiForgeryToken()
                <a href="@Url.Action("Create","ProductUnit")" class="btn btn-primary"><i class="glyphicon glyphicon-edit"></i>Create</a>
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" style="margin-top:10px;">
                    <div class="row" style="margin-bottom:10px; width: 100%;">
                        <table class="table table-bordered table-hover table-responsive table-striped" style="width: 100%;" id="UnitTable">
                            <thead>
                                <tr style="background:#12baa5;">
                                    <th style="font-size: 10px; text-align: center; display:none;">
                                        Unit Auto ID
                                    </th>
                                    <th style="font-size: 10px; text-align: center; width: 55%;">
                                        Unit ID
                                    </th>
                                    <th style="font-size: 10px; text-align: center; width: 55%;">
                                        Unit Name
                                    </th>
                                    <th style="font-size: 10px; text-align: center; width: 35%; ">
                                        Short Name
                                    </th>
                                    <th style="width: 5%; "></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td style="font-size: 11px; width: 100%; display:none;" class="UnitID">
                                            @Html.DisplayFor(modelItem => item.vProductUnitAutoID, new { @id = "vProductUnitAutoID" })
                                        </td>
                                        <td style="font-size: 11px;">
                                            @Html.DisplayFor(modelItem => item.vProductUnitID)
                                        </td>
                                        <td style="font-size: 11px;">
                                            @Html.DisplayFor(modelItem => item.vProductUnitName)
                                        </td>
                                        <td style="font-size: 11px;">
                                            @Html.DisplayFor(modelItem => item.vProductUnitShortName)
                                        </td>
                                        <td>
                                            <a href="@Url.Action("Create", "ProductUnit", new { unitID = @item.vProductUnitAutoID })" class="btn btn-primary"><i class="glyphicon glyphicon-pencil"></i></a>
                                            @*@Html.ActionLink("Edit", "Edit", new { /* id=item.PrimaryKey */ }) |
                                                @Html.ActionLink("Details", "Details", new { /* id=item.PrimaryKey */ }) |
                                                @Html.ActionLink("Delete", "Delete", new { /* id=item.PrimaryKey */ })*@
                                            @*<input type="button" value="Edit" id="btnEdit" class="btnEdit btn btn-primary" />*@
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            $('#UnitTable').DataTable();

            @*$('#UnitTable').on('click', '.btnEdit', function () {
                $.ajax({
                    type: 'GET',
                    url: '@Url.Action("Create", "UnitInformation")',
                    data: { unitID: $(this).parents('tr').find('.UnitID').text() },
                    success: function (response) {
                        window.location.href = '@Url.Action("Create","UnitInformation")';
                    }
                });
            });*@
        });
    </script>
}