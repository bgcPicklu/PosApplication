        function amountCalculation() {
            var luQty = 0.0;
            var suQty = 0.0;
            var amount = 0.0;
            var discount = 0.0;
            var vatPercentage = 0.0;
            if (!isNaN(parseFloat($('#luQty').val()))) {
                luQty = parseFloat($('#luQty').val());
            }
            if (!isNaN(parseFloat($('#suQty').val()))) {
                suQty = parseFloat($('#suQty').val());
            }
            if (!isNaN(parseFloat($('#discount').val()))) {
                discount = parseFloat($('#discount').val());
            }
            if (!isNaN(parseFloat($('#purchaseRate').val()))) {
                amount = parseFloat($('#purchaseRate').val());
            }
            if (luQty == 0 && suQty == 0) {
                $('#purchaseRate').val('');
            }
            else
            {
                var purchaseRate = ((luQty * (parseFloat($('#MaxQty').text()) * parseFloat($('#MinQty').text()))) + suQty) * parseFloat($('#purchaseRate').val());
                $('#vAmount').text((!isNaN(purchaseRate)?purchaseRate:0).toFixed(2));
            }
        }

