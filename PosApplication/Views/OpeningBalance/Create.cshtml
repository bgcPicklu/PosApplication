            showButtionPanel: true,
            highlightWeek: true,
            autoclose: true,
            onSelect: function (dateText) {
                $(this).change();
            }
        }).on('change', function () {
            $.ajax({
                url: '@Url.Action("getReferenceNo","OpeningBalance")',
                type: 'GET',
                data: { dDate: $(this).val() },
                success: function (data) {
                    $('#ReferenceNo').val(data.vReferenceNo);
                }
            });
        });

        var productName = [];
        var dupProduct = [];

        function renderProductName(element, productName) {
            var $ele = $(element);
            $ele.empty();
            $ele.append($('<option/>').val('0').text('--Select--'));
            $.each(productName, function (i, val) {
                $ele.append($('<option/>').val(val.vProductID).text(val.vProductName));
            });
        }

        function loadProductName(element) {
            debugger;
            var supplierID = $('#SupplierId').val();
            if (supplierID == 0)
                supplierID = '%';
            var packID = $('#PackId').val();
            if (packID == 0)
                packID = '%';
            $.ajax({
                url: '@Url.Action("GetAllProduct", "OpeningBalance")',
                type: "GET",
                data: { supplierID: supplierID, packID: packID, ReferenceNoAuto: $('#vReferenceNoAuto').val() },
                success: function (data) {
                    productName = data;
                    renderProductName(element, productName);
                }
            });
        }

