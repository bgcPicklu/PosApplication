        $('#btnAddEdit').click(function () {
            var isAllValid = true;
            if ($('#productID').val() == '0') {
                isAllValid = false;
                $('#productID').notify("Please select product Name!!!", "warn");
            }
            if (isNaN(parseFloat($('#luQty').val()))) {
                isAllValid = false;
                $('#luQty').notify("Please provide large unit qty!!!", "warn");
            }
            if (isNaN(parseFloat($('#suQty').val()))) {
                isAllValid = false;
                $('#suQty').notify("Please provide small unit qty!!!", "warn");
            }
            if (isNaN(parseFloat($('#purchaseRate').val()))) {
                isAllValid = false;
                $('#purchaseRate').notify("Please provide purchase rate!!!", "warn");
            }

            if (parseFloat($('#purchaseRate').val()) > parseFloat($('#SalesRate').text())) {
                isAllValid = false;
                $.notify("Purchase rate is greater than sales rate. Please check!!!", "warn");
            }

            $.each(dupProduct, function (i, value) {
                if (value == $('#productID').val()) {
                    isAllValid = false;
                    $('#productID').notify('Product already exists in the list.', 'warn');
                    $('#productID').val('0');
                    $('#packName').text('');
                    $('#MaxQty').text('');
                    $('#MinQty').text('');
                    $('#currentStock').text('');
                    $('#luQty').val('');
                    $('#suQty').val('');
                    $('#purchaseRate').val('');
                    $('#vAmount').text('');
                    $('#SalesRate').text('');
                    $('#productID').focus();
                }
            });

            if (isAllValid) {
                dupProduct.push($('#productID').val());
                $('#tbProduct tbody').append('<tr id = "mainRow">'+
                    '<td style="display: none; font-size: 10px;" class="ProductID">' + $('#productID').val() + '</td>' +
                    '<td style="font-size: 10px;" class="ProductName">' + $('#productID option:selected').text() + '</td>' +
                    '<td style="font-size: 10px;" class="packName">' + $('#packName').text() + '</td>' +
                    '<td style="font-size: 10px; text-align: right;" class="MaxQty">' + $('#MaxQty').text() + '</td>' +
                    '<td style="font-size: 10px; text-align: right;" class="MinQty">' + $('#MinQty').text() + '</td>' +
                    '<td style="font-size: 10px; text-align: right;" class="currentStock">' + $('#currentStock').text() + '</td>' +
                    '<td style="font-size: 10px; text-align: right;" class="luQty">' + $('#luQty').val() + '</td>' +
                    '<td style="font-size: 10px; text-align: right;" class="suQty">' + $('#suQty').val() + '</td>' +
                    '<td style="font-size: 10px; text-align: right;" class="purchaseRate">' + $('#purchaseRate').val() + '</td>' +
                    '<td style="font-size: 10px; text-align: right;" class="ProductAmount">' + $('#vAmount').text() + '</td>' +
                    '<td style="font-size: 10px; text-align: right;" class="SalesRate">' + $('#SalesRate').text() + '</td>' +
                    '<td><input type = "button" id = "btnRemove" class="btnRemove btn btn-danger" value = "Remove" style="font-size: 8px; width: 60px; margin-right: 10%;" /><input type = "button" id = "btnEdit" class="btnEdit btn btn-success" value = "Edit" style="font-size: 8px;  width: 60px;" /></td></tr>');
                var grandTotal = parseFloat($('#totalAmount').text());
                if (isNaN(grandTotal))
                    grandTotal = 0.0;
                grandTotal += parseFloat($('#vAmount').text());
                $('#totalAmount').text(grandTotal.toFixed(2));
            }
            $('#productID').val('0');
            $('#packName').text('');
            $('#MaxQty').text('');
            $('#MinQty').text('');
            $('#currentStock').text('');
            $('#luQty').val('');
            $('#suQty').val('');
            $('#purchaseRate').val('');
            $('#vAmount').text('');
            $('#SalesRate').text('');
            $('#productID').focus();
            $('#SupplierId').val('0');
            loadProductName($('#productID'));
        });

        $('#tbProduct').on('click', '.btnRemove', function () {
            var grandTotal = parseFloat($('#totalAmount').text());
            grandTotal -= parseFloat($(this).parents('tr').find('.ProductAmount').text());
            $('#totalAmount').text(grandTotal);
            $(this).parents('tr').remove();
            dupProduct = [];
            $('#tbProduct tbody').find('tr').each(function (i, event) {
                var $td = $(this).find('td');
                dupProduct.push($td.eq(0).text());
            });
        });

        $('#tbProduct').on('click', '.btnEdit', function () {
            $('#productID').val($(this).parents('tr').find('.ProductID').text());
            $('#packName').text($(this).parents('tr').find('.packName').text());
            $('#MaxQty').text($(this).parents('tr').find('.MaxQty').text());
            $('#MinQty').text($(this).parents('tr').find('.MinQty').text());
            $('#currentStock').text($(this).parents('tr').find('.currentStock').text());
            $('#luQty').val($(this).parents('tr').find('.luQty').text());
            $('#suQty').val($(this).parents('tr').find('.suQty').text());
            $('#purchaseRate').val($(this).parents('tr').find('.purchaseRate').text());
            $('#vAmount').text($(this).parents('tr').find('.ProductAmount').text());
            $('#SalesRate').text($(this).parents('tr').find('.SalesRate').text());
            var grandTotal = parseFloat($('#totalAmount').text());
            grandTotal -= parseFloat($(this).parents('tr').find('.ProductAmount').text());
            $('#totalAmount').text(grandTotal.toFixed(2));
            $(this).parents('tr').remove();
            dupProduct = $.grep(dupProduct, function (value) { return value != $('#productID').val(); });
        });

        $('#btnProceed').click(function () {
            var date = $('#OpeningDate').val();
            var ReferenceNo = $('#ReferenceNo').val();
            debugger;
            $('#tbProduct tbody').empty();
            $('#totalAmount').text('0.00');
            var tableData = [];
            dupProduct = [];
            var total_Amount = 0.0;
            $.ajax({
                url: '@Url.Action("getDataForEdit", "OpeningBalance")',
                data: { dDate: date, ReferenceNoAuto: $('#vReferenceNoAuto').val(), vReferenceNo: $('#ReferenceNo').val(), vChallanNo: $('#ChallanNo').val() },
                type: 'GET',
                success: function (data) {
                    $('#OpeningDate').val(data.masterData.dOpeningDate);
                    $('#vReferenceNoAuto').val(data.masterData.vReferenceNoAuto);
                    $('#ReferenceNo').val(data.masterData.vReferenceNo);
                    $('#ChallanNo').val(data.masterData.vChallanNo);
                    $('#totalAmount').text(data.masterData.mTotalAmount);
                    $('#Remarks').val(data.masterData.vRemarks);
                    tableData = data.detailData;
                    $.each(tableData, function (i, value) {
                        dupProduct.push(value.vProductId);
                        $('#tbProduct').append('<tr id = "mainRow">' +
                    '<td style="display: none; font-size: 10px;" class="ProductID">' + value.vProductId + '</td>' +
                    '<td style="font-size: 10px;" class="ProductName">' + value.vProductName + '</td>' +
                    '<td style="font-size: 10px;" class="packName">' + value.vPackName + '</td>' +
                    '<td style="font-size: 10px; text-align: right;" class="MaxQty">' + value.mMaxQty + '</td>' +
                    '<td style="font-size: 10px; text-align: right;" class="MinQty">' + value.mMinQty + '</td>' +
                    '<td style="font-size: 10px; text-align: right;" class="currentStock">' + value.mCurrentStock + '</td>' +
                    '<td style="font-size: 10px; text-align: right;" class="luQty">' + value.mLuQty + '</td>' +
                    '<td style="font-size: 10px; text-align: right;" class="suQty">' + value.mSuQty + '</td>' +
                    '<td style="font-size: 10px; text-align: right;" class="purchaseRate">' + value.mPurchaseRate + '</td>' +
                    '<td style="font-size: 10px; text-align: right;" class="ProductAmount">' + value.TotalAmount + '</td>' +
                    '<td style="font-size: 10px; text-align: right;" class="SalesRate">' + value.mSalesRate + '</td>' +
                    '<td><input type = "button" id = "btnRemove" class="btnRemove btn btn-danger" value = "Remove" style="font-size: 8px; width: 60px; margin-right: 10%;" /><input type = "button" id = "btnEdit" class="btnEdit btn btn-success" value = "Edit" style="font-size: 8px;  width: 60px;" /></td></tr>');
                    });
                    loadProductName($('#productID'));
                }
            });

            $('#SupplierId').prop('disabled', false);
            $('#PackId').prop('disabled', false);
            $('#productID').prop('disabled', false);
            $('#luQty').prop('disabled', false);
            $('#suQty').prop('disabled', false);
            $('#purchaseRate').prop('disabled', false);
        });

        function validityCheck() {
            var validity = false;
            if ($('#OpeningDate').val()) {
                if ($('#ReferenceNo').val()) {
                    $('#tbProduct tbody').find('tr').each(function (i, event) {
                        var $td = $(this).find('td');
                        if (parseFloat($td.eq(8).text()) < parseFloat($td.eq(10).text())) {
                            validity = true;
                        }
                        else {
                            $.notify('Please check purchase rate & sale rate!', 'warn');
                            validity = false;
                        }
                    });
                } else {
                    $('#ReferenceNo').notify('Please provide opening reference!', 'warn');
                    $('#ReferenceNo').focus();
                    validity = false;
                }
            } else {
                $('#OpeningDate').notify('Please provide opening data!', 'warn');
                $('#OpeningDate').focus();
                validity = false;
            }
            return validity;
        }

        var totalData = [];
        $('#btnSubmit').click(function () {
            $('#tbProduct tbody').find('tr').each(function (i, event) {
                var $td = $(this).find('td');
                totalData.push({
                    vProductId: $td.eq(0).text(),
                    mLuQty: ($td.eq(6).text()),
                    mSuQty: ($td.eq(7).text()),
                    mCurrentStock: ($td.eq(5).text()),
                    mTotalQty: ((parseFloat($td.eq(6).text()) * parseFloat($td.eq(3).text()) * parseFloat($td.eq(4).text())) + parseFloat($td.eq(7).text())),
                    mPurchaseRate: ($td.eq(8).text()),
                    TotalAmount: ($td.eq(9).text()),
                    mSalesRate: ($td.eq(10).text())
                });
            });

            debugger;
            if (validityCheck()) {
                if (totalData.length != 0) {
                    bootbox.confirm('Do you want to save this information?', function (result) {
                        if (result) {
                            $.ajax({
                                url: '@Url.Action("Create", "OpeningBalance")',
                                type: "POST",
                                data: JSON.stringify({
                                    dOpeningDate: $('#OpeningDate').val(),
                                    vChallanNo: $('#ChallanNo').val(),
                                    vReferenceNoAuto: $('#vReferenceNoAuto').val(),
                                    vReferenceNo: $('#ReferenceNo').val(),
                                    vRemarks: $('#Remarks').val(),
                                    mTotalAmount: $('#totalAmount').text(),
                                    OpeningDetailsList: totalData
                                }),
                                dataType: "JSON",
                                contentType: 'application/json',
                                success: function (response) {
                                    if(response.success)
                                    {
                                        totalData = [];
                                        $.notify(response.message, "success");
                                        window.setTimeout(function () { window.location.href = '@Url.Action("Create", "OpeningBalance")' }, 1000);
                                    }
                                    else {
                                        $.notify(response.message, "error");
                                    }
                                }
                            });
                        }
                    });
                }
            }
        });
        loadProductName($('#productID'));
    </script>
}
