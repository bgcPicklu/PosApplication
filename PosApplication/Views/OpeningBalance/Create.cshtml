@using PosApplication.Models;
@model PosApplication.Models.OpeningBalanceMasterModel
<div style="margin-top: 90px;">
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12" style="margin: auto;">
        <div class="panel panel-bd lobidisable">
            <div class="panel-heading">
                <div class="panel-title">
                    <h4>Opening Balance Entry</h4>
                </div>
            </div>
            <div style="height:97%; width:100%; overflow:auto; padding:0; margin:0 auto; margin-left:10px; margin-top:10px;">
                @Html.AntiForgeryToken()
                <input type="button" id="btnFind" value="Find" class="btn btn-primary" />
                <hr />
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" style="margin-top:10px;">
                    <div class="row">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" style="margin-top:10px;">
                            <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                <div class="row">
                                    <div class="col-lg-5 col-md-5 col-sm-4 col-xs-4">
                                        @Html.Label("Opening Date:", new { @class = "control-label", @style = "font-size:10px;" })
                                    </div>
                                    <div class="col-lg-7 col-md-7 col-sm-8 col-xs-8">
                                        @Html.TextBoxFor(model => model.dOpeningDate, new { @class = "form-control", @id = "OpeningDate", @readonly = "readonly", @style = "background: #fff;" })
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                <div class="row">
                                    <div class="col-lg-5 col-md-5 col-sm-4 col-xs-4">
                                        @Html.Label("Reference No:", new { @class = "control-label", @style = "font-size:10px;" })
                                    </div>
                                    <div class="col-lg-7 col-md-7 col-sm-8 col-xs-8">
                                        @Html.TextBoxFor(model => model.vReferenceNo, new { @class = "form-control", @id = "ReferenceNo", @readonly = "readonly", @style = "background: #fff;" })
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                <div class="row">
                                    <div class="col-lg-6 col-md-6 col-sm-4 col-xs-4">
                                        @Html.Label("Opening Refrence:", new { @class = "control-label", @style = "font-size:10px;" })
                                    </div>
                                    <div class="col-lg-6 col-md-6 col-sm-8 col-xs-8">
                                        @Html.TextBoxFor(model => model.vChallanNo, new { @class = "form-control", @id = "ChallanNo" })
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                <div class="row">
                                    <div class="col-lg-1 col-md-1 col-sm-12 col-xs-12">
                                        <div class="row">
                                            <div class="col-lg-1 col-md-1 col-sm-1 col-xs-1">
                                                <input type="button" value="Proceed" class="btn btn-primary pull-left" id="btnProceed" style="font-size: 12px;" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" style="margin-top:10px;">
                    <div class="row">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" style="margin-top:20px;">
                            <div class="col-lg-7 col-md-7 col-sm-12 col-xs-12">
                                <div class="row">
                                    <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                                        @Html.Label("Supplier Name:", new { @class = "control-label", @style = "font-size:10px;" })
                                    </div>
                                    <div class="col-lg-9 col-md-9 col-sm-9 col-xs-9">
                                        @Html.DropDownListFor(model => model.vSupplierId, new SelectList(DropDownListModel.GetSupplier, "Value", "Text", "0"), new { @class = "form-control", @id = "SupplierId", @disabled = true })
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                <div class="row">
                                    <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                                        @Html.Label("Pack Size:", new { @class = "control-label", @style = "font-size:10px;" })
                                    </div>
                                    <div class="col-lg-9 col-md-9 col-sm-9 col-xs-9">
                                        @Html.DropDownListFor(model => model.vPackSize, new SelectList(DropDownListModel.GetPackSize, "Value", "Text", "0"), new { @class = "form-control", @id = "PackId", @disabled = true })
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" style="margin-top:10px;">
                    <div class="row" style="max-height: 500px; overflow: auto;">
                        <table class="table table-responsive table-striped table-bordered table-hover table-condensed" style="width: 98%;">
                            <thead style="background: #1088b9; color: white;">
                                <tr>
                                    <th style="text-align: center; width: 23%; font-size: 8px;">Product Name</th>
                                    <th style="text-align: center; width: 4%; font-size: 8px;">Pack</th>
                                    <th style="text-align: center; width: 6%; font-size: 8px;">Max Qty</th>
                                    <th style="text-align: center; width: 6%; font-size: 8px;">Min Qty</th>
                                    <th style="text-align: center; width: 6%; font-size: 8px;">C.Stock</th>
                                    <th style="text-align: center; width: 6%; font-size: 8px; ">LU Qty.</th>
                                    <th style="text-align: center; width: 6%; font-size: 8px;">SU Qty.</th>
                                    <th style="text-align: center; width: 5%; font-size: 8px; ">P.Rate</th>
                                    <th style="text-align: center; width: 6%; font-size: 8px; ">Amount</th>
                                    <th style="text-align: center; width: 5%; font-size: 8px;">S.Rate</th>
                                    <th style="width: 3%; font-size: 10px;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td style="width: 23%;">
                                        <select id="productID" class="form-control" disabled="disabled">
                                            <option>--Select--</option>
                                        </select>
                                    </td>
                                    <td style="width: 4%;">
                                        <label id="packName" style="font-size: 10px; font-weight:normal; text-align:right; width: 100%;"></label>
                                    </td>
                                    <td style="width: 6%;">
                                        <label id="MaxQty" style="font-size: 10px; font-weight: normal; text-align: right; width: 100%; "></label>
                                    </td>
                                    <td style="width: 6%;">
                                        <label id="MinQty" style="font-size: 10px; font-weight: normal; text-align: right; width: 100%; "></label>
                                    </td>
                                    <td style="width: 5%;">
                                        <label id="currentStock" style="font-size: 10px; font-weight: normal; text-align: right; width: 100%; "></label>
                                    </td>
                                    <td style="width: 6%;">
                                        <input type="text" id="luQty" class="form-control" disabled="disabled" style="text-align: right; margin-right: 20%;" />
                                    </td>
                                    <td style="width: 6%;">
                                        <input type="text" id="suQty" class="form-control" disabled="disabled" style="text-align: right; margin-right: 20%;" />
                                    </td>
                                    <td style="width: 8%;">
                                        <input type="text" id="purchaseRate" class="form-control" disabled="disabled" style="text-align: right; margin-right: 20%;" />
                                    </td>
                                    <td style="width: 6%;">
                                        <label id="vAmount" style="font-size: 10px; font-weight: normal; text-align: right; width: 100%; "></label>
                                    </td>
                                    <td style="width: 5%;">
                                        <label id="SalesRate" style="font-size: 10px; font-weight: normal; text-align: right; width: 100%; "></label>
                                    </td>
                                    <td style="width: 3%;">
                                        <input type="button" class="btn btn-success" value="Add" id="btnAddEdit" style="width: 60px; float: right; font-size: 12px;" />
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" style="margin-top:10px;">
                    <div class="row" style="max-height: 500px; overflow: auto;">
                        <table class="table table-responsive table-striped table-bordered table-hover table-condensed" id="tbProduct" style="width: 98%;">
                            <thead style="background: #1088b9; color: white;">
                                <tr>
                                    <th style="display: none; font-size: 8px;">Product ID</th>
                                    <th style="text-align: center; width: 18%; font-size: 8px;">Product Name</th>
                                    <th style="text-align: center; width: 4%; font-size: 8px;">Pack</th>
                                    <th style="text-align: center; width: 6%; font-size: 8px;">Max Qty</th>
                                    <th style="text-align: center; width: 6%; font-size: 8px;">Min Qty</th>
                                    <th style="text-align: center; width: 6%; font-size: 8px;">C.Stock</th>
                                    <th style="text-align: center; width: 6%; font-size: 8px; ">LU Qty.</th>
                                    <th style="text-align: center; width: 6%; font-size: 8px;">SU Qty.</th>
                                    <th style="text-align: center; width: 5%; font-size: 8px; ">P.Rate</th>
                                    <th style="text-align: center; width: 6%; font-size: 8px; ">Amount</th>
                                    <th style="text-align: center; width: 5%; font-size: 8px;">S.Rate</th>
                                    <th style="width: 11%; font-size: 10px;"></th>
                                </tr>
                            </thead>
                            <tfoot>
                                <tr>
                                    <td colspan="8" style="width: 100%; text-align: right; font-size: 10px;">Total = </td>
                                    <td><label id="totalAmount" style="text-align: right; width: 100%; font-size: 10px;"></label></td>
                                    <td colspan="2"></td>
                                </tr>
                            </tfoot>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>

                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" style="margin-top:10px;">
                        <div class="row">
                            <div class="col-lg-1 col-md-1 col-sm-4 col-xs-4">
                                @Html.Label("Remarks:", new { @class = "control-label", @style = "font-size:10px;" })
                            </div>
                            <div class="col-lg-8 col-md-8 col-sm-8 col-xs-8">
                                @Html.TextBoxFor(model => model.vRemarks, new { @class = "form-control", @id = "Remarks" })
                            </div>
                        </div>
                </div>

                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" style="margin-top:10px;">
                    <div class="row" style="margin-top: 5px; margin-bottom: 5px;">
                        <div class="col-sm-4 col-xs-2"></div>
                        <div class="col-sm-2 col-xs-4">
                            <input type="button" value="Submit" id="btnSubmit" class="btn btn-success" style="width: 99%; max-width: 70px; float: right; font-size: 12px;" />
                        </div>
                        <div class="col-sm-2 col-xs-4">
                            <input type="button" value="Reset" id="btnReset" class="btn btn-success" style="width: 99%; max-width: 70px; float: left; font-size: 12px;" />
                        </div>
                    </div>
                </div>

                <div></div>
            </div>
        </div>
    </div>
</div>
<input type="hidden" id="vReferenceNoAuto" />
@section Scripts{
