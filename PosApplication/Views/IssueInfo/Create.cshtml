    function validityCheck() {
        var validity = false;
        if ($('#IssueDate').val()) {
            if ($('#ReferenceNo').val()) {
                if ($('#IssueNo').val()) {
                    if ($('#IssueTo').val() != '0') {
                        if ($('#ReceivedBy').val()) {
                            validity = true;
                        } else {
                            $('#ReceivedBy').notify('Please provide receive by name!', 'warn');
                            $('#ReceivedBy').focus();
                            validity = false;
                        }
                    } else {
                        $('#IssueTo').notify('Please provide issue to unit!', 'warn');
                        $('#IssueTo').focus();
                        validity = false;
                    }
                } else {
                    $('#IssueNo').notify('Please provide issue no.!', 'warn');
                    $('#IssueNo').focus();
                    validity = false;
                }
            } else {
                $('#ReferenceNo').notify('Please provide Reference no.!', 'warn');
                $('#ReferenceNo').focus();
                validity = false;
            }
        } else {
            $('#IssueDate').notify('Please provide purchase data!', 'warn');
            $('#IssueDate').focus();
            validity = false;
        }
        return validity;
    }

    var totalData = [];
    $('#btnSubmit').click(function () {
        $('#tbProduct tbody').find('tr').each(function (i, event) {
            var $td = $(this).find('td');
            totalData.push({
                vProductID: $td.eq(0).text(),
                mCurrentStock: ($td.eq(5).text()),
                mLuQty: ($td.eq(6).text()),
                mSuQty: ($td.eq(7).text()),
                mTotalQty: ($td.eq(8).text()),//((parseFloat($td.eq(6).text()) * parseFloat($td.eq(3).text()) * parseFloat($td.eq(4).text())) + parseFloat($td.eq(7).text())),
                mIssueRate: ($td.eq(9).text()),
                mSalesRate: ($td.eq(10).text())
            });
        });

        debugger;
        if (validityCheck()) {
            if (totalData.length != 0) {
                bootbox.confirm('Do you want to save this information?', function (result) {
                    if (result) {
                        $.ajax({
                            url: '@Url.Action("Create", "IssueInfo")',
                            type: "POST",
                            data: JSON.stringify({
                                dIssueDate: $('#IssueDate').val(),
                                vReferenceNoAuto: $('#vReferenceNoAuto').val(),
                                vReferenceNo: $('#ReferenceNo').val(),
                                vIssueNo: $('#IssueNo').val(),
                                vIssueTo: $('#IssueTo').val(),
                                vReceivedBy: $('#ReceivedBy').val(),
                                vRemarks: $('#Remarks').val(),
                                lstIssueDetails: totalData
                            }),
                            dataType: "JSON",
                            contentType: 'application/json',
                            success: function (response) {
                                if (response.success) {
                                    totalData = [];
                                    $.notify(response.message, "success");
                                    window.setTimeout(function () { window.location.href = '@Url.Action("Create", "IssueInfo")' }, 1000);
                                }
                                else {
                                    $.notify(response.message, "error");
                                }
                            }
                        });
                    }
                });
            }
        }
    });

