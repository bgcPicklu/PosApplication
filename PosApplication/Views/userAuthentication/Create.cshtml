@using PosApplication.Models;
@model PosApplication.Models.userAuthenticationModel

<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12" style="margin-top: 90px;">
    <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7" style="margin: auto;">
        <div class="panel panel-bd lobidisable">
            <div class="panel-heading">
                <div class="panel-title">
                    <h4>User Authentication</h4>
                </div>
            </div>
            <div style="height: 97%; width: 100%; overflow: auto; padding: 0; margin: 0 auto; margin-left: 10px; margin-top: 10px;">
                @Html.AntiForgeryToken()
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                    <div class="row" style="margin-bottom:10px;">
                        <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                            @Html.Label("Unit Name :", new { @style = "font-size: 10px;" })
                        </div>
                        <div class="col-lg-9 col-md-9 col-sm-9 col-xs-9">
                            @Html.DropDownListFor(m => m.vUnitID, new SelectList(DropDownListModel.GetActiveUnitName, "Value", "Text", "0"), new { @class = "form-control", @id = "UnitID" })
                        </div>
                    </div>
                </div>

                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                    <div class="row" style="margin-bottom:10px;">
                        <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                            @Html.Label("User Name :", new { @style = "font-size: 10px;" })
                        </div>
                        <div class="col-lg-9 col-md-9 col-sm-9 col-xs-9">
                            <select id="vUserName" class="form-control">
                                <option>--Select--</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                    <div class="row" style="margin-bottom:10px;">
                        <table class="table table-responsive table-striped table-bordered table-hover table-condensed" id="tbAuthentication" style="width: 98%; display: block;">
                            <thead style="background: skyblue;">
                                <tr>
                                    <th style="display: none; font-size: 8px;">Menu ID</th>
                                    <th style="text-align: center; width: 60%; font-size: 8px;">Menu Name</th>
                                    <th style="text-align: center; width: 16%; font-size: 8px;">Menu Type</th>
                                    <th style="text-align: center; width: 6%; font-size: 8px;">Show</th>
                                    <th style="text-align: center; width: 6%; font-size: 8px;">Save</th>
                                    <th style="text-align: center; width: 6%; font-size: 8px;">Edit</th>
                                    <th style="text-align: center; width: 6%; font-size: 8px;">Delete</th>
                                </tr>
                            </thead>
                            <tbody style="width:100%; height: 280px; overflow: auto;"></tbody>
                        </table>
                    </div>
                </div>

                @*<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <div class="row" style="margin-bottom:10px;">
                            <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                                @Html.Label("Confirm Password :", new { @style = "font-size: 12px;" })
                            </div>
                            <div class="col-lg-9 col-md-9 col-sm-9 col-xs-9">
                                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", @id = "ConfirmPassword" })
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <div class="row" style="margin-bottom:10px;">
                            <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                                @Html.Label("Account Type :", new { @style = "font-size: 12px;" })
                            </div>
                            <div class="col-lg-9 col-md-9 col-sm-9 col-xs-9">
                                @Html.DropDownListFor(m => m.AccountType, new SelectList(DropDownListModel.GetAccountType, "Value", "Text", "0"), new { @class = "form-control", @id = "AccountType" })
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <div class="row" style="margin-bottom:10px;">
                            <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                                @Html.Label("Status :", new { @style = "font-size: 12px;" })
                            </div>
                            <div class="col-lg-9 col-md-9 col-sm-9 col-xs-9">
                                @Html.DropDownListFor(m => m.Status, new SelectList(DropDownListModel.GetStatus, "Value", "Text", "0"), new { @class = "form-control", @id = "Status" })
                            </div>
                        </div>
                    </div>*@

                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                    <div class="row" style="margin-bottom:10px;">
                        <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                        </div>
                        <div class="col-lg-9 col-md-9 col-sm-9 col-xs-9">
                            <input type="button" class="btn btn-primary pull-right" id="btnSave" value="Save" style="margin-right: 25px;" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<input type="hidden" id="userNameEdit" />

@section Scripts{
    @Scripts.Render("~/bundles/jqueryval")
    <script type="text/javascript">
        $(document).ready(function () {
            var userData = [];
            $('#UnitID').change(function (event) {
                $.ajax({
                    url: '@Url.Action("GetUserName", "userAuthentication")',
                    type: 'GET',
                    data: { UnitID : $('#UnitID').val() },
                    success: function (data) {
                        userData = data;
                        renderUser($('#vUserName'),userData);
                    }
                });
            });

            function renderUser(element, userData) {
                var $ele = $(element);
                $ele.empty();
                $.each(userData, function (i, user) {
                    $ele.append($('<option/>').val(user.UserID).text(user.UserName));
                });
            }

            $('#UnitID').change(function () {
                $('#tbAuthentication tbody').empty();
            });

            $('#vUserName').change(function () {
                $('#tbAuthentication tbody').empty();
                var userID = $(this).val();
                if (userID != "0")
                {
                    $.ajax({
                        url: '@Url.Action("GetAuthenticationData","userAuthentication")',
                        type: 'GET',
                        data: { UserID: userID, UnitID: $('#UnitID').val() },
                        success: function (data) {
                            $.each(data.DetailsData, function (i, value) {
                                $('#tbAuthentication').append('<tr class = "mainrow"><td style="display: none; font-size: 12px;" id="MenuID' + i + '">' + value.vMenuID + '</td>' +
                                        '<td style="text-align: left; width: 60%; font-size: 12px;" id="MenuName' + i + '">' + value.vMenuName + '</td>' +
                                        '<td style="text-align: left; width: 16%; font-size: 12px;" id="MenuType' + i + '">' + value.vMenuType + '</td>' +
                                        '<td style="text-align: center; width: 6%; font-size: 12px;" class="Show"><input type="checkbox" id = "chkShow' + i + '" /></td>' +
                                        '<td style="text-align: center; width: 6%; font-size: 12px;" class="Save"><input type="checkbox" id = "chkSave' + i + '" /></td>' +
                                        '<td style="text-align: center; width: 6%; font-size: 12px;" class="Edit"><input type="checkbox" id = "chkEdit' + i + '" /></td>' +
                                        '<td style="text-align: center; width: 6%; font-size: 12px;" class="Delete"><input type="checkbox" id = "chkDelete' + i + '" /></td></tr>');

                                if (value.iShow == "1")
                                    $('#chkShow' + i).prop('checked', true);
                                else
                                    $('#chkShow' + i).prop('checked', false);
                                if (value.iSave == "1")
                                    $('#chkSave' + i).prop('checked', true);
                                else
                                    $('#chkSave' + i).prop('checked', false);
                                if (value.iEdit == "1")
                                    $('#chkEdit' + i).prop('checked', true);
                                else
                                    $('#chkEdit' + i).prop('checked', false);
                                if (value.iDelete == "1")
                                    $('#chkDelete' + i).prop('checked', true);
                                else
                                    $('#chkDelete' + i).prop('checked', false);
                            });
                        }
                    });
                }
            });

            //function formCheck() {
            //    if ($('#UnitID').val() != "0") {
            //        if ($('#UserName').val()) {
            //            if ($('#Password').val()) {
            //                if ($('#ConfirmPassword').val()) {
            //                    if ($('#AccountType').val() != "0") {
            //                        if ($('#Status').val() != "0") {
            //                            return true;
            //                        }
            //                        else {
            //                            $('#Status').notify("Please select status!", "warn");
            //                            $('#Status').focus();
            //                            return false;
            //                        }
            //                    }
            //                    else {
            //                        $('#AccountType').notify("Please select account type!", "warn");
            //                        $('#AccountType').focus();
            //                        return false;
            //                    }
            //                }
            //                else {
            //                    $('#ConfirmPassword').notify("Please provide confirm password!", "warn");
            //                    $('#ConfirmPassword').focus();
            //                    return false;
            //                }
            //            }
            //            else {
            //                $('#Password').notify("Please provide password!", "warn");
            //                $('#Password').focus();
            //                return false;
            //            }
            //        }
            //        else {
            //            $('#UserName').notify("Please provide username!", "warn");
            //            $('#UserName').focus();
            //            return false;
            //        }
            //    }
            //    else {
            //        $('#UnitID').notify("Please select unit!", "warn");
            //        $('#UnitID').focus();
            //        return false;
            //    }
            //}

            var lstValues = [];
            $('#btnSave').click(function () {
                //if (formCheck())
                //{
                bootbox.confirm("Do you want to save this information?", function (result) {
                    if (result) {
                        var iShow = 0;
                        var iSave = 0;
                        var iEdit = 0;
                        var iDelete = 0;
                        $('#tbAuthentication tbody').find('tr').each(function (i, value) {
                            iShow = 0;
                            iSave = 0;
                            iEdit = 0;
                            iDelete = 0;
                            if($('#chkShow'+i).is(':checked'))
                                iShow = 1;
                            if($('#chkSave'+i).is(':checked'))
                                iSave = 1;
                            if($('#chkEdit'+i).is(':checked'))
                                iEdit = 1;
                            if($('#chkDelete'+i).is(':checked'))
                                iDelete = 1;
                            lstValues.push({
                                vUnitID: $('#UnitID').val(),
                                vUserName: $('#vUserName').val(),
                                vMenuID: $('#MenuID' + i).text(),
                                vMenuName: $('#MenuName' + i).text(),
                                iShow: iShow,
                                iSave: iSave,
                                iEdit: iEdit,
                                iDelete: iDelete
                            });
                        });
                        debugger;
                        $.ajax({
                            url: '@Url.Action("Create","userAuthentication")',
                            type: "POST",
                            data: JSON.stringify({ lstUserAuthentication: lstValues }),
                            dataType: "JSON",
                            contentType: 'application/json',
                            success: function (data) {
                                if (data.success) {
                                    $.notify(data.message, "success");
                                    window.setTimeout(function(){window.location.href = '@Url.Action("Create","userAuthentication")'}, 1000);
                                }
                                else
                                    $(data.message, "error");
                            }
                        });
                    }
                });
                //}
