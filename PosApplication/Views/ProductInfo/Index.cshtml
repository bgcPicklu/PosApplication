@model IEnumerable<PosApplication.Models.ProductInfoModel>


<div style="margin-top: 90px;">
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
        <div class="panel panel-bd lobidisable">
            <div class="panel-heading">
                <div class="panel-title">
                    <h4>Product Information</h4>
                </div>
            </div>
            <div style="height:97%; width:100%; overflow:auto; padding:0; margin:0 auto; margin-left:10px; margin-top: 10px;">
                @Html.AntiForgeryToken()
                <a href="@Url.Action("Create","ProductInfo")" class="btn btn-primary"><i class="glyphicon glyphicon-edit"></i>Create</a>
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" style="margin-top:10px;">
                    <div class="row" style="margin-bottom:10px; width: 100%;">
                        <table class="table table-bordered table-hover table-responsive table-striped" style="width: 100%;" id="ProductTable">
                            <thead>
                                <tr style="background:#12baa5;">
                                    <th style="font-size: 10px; text-align: center; display:none;">
                                        Product ID
                                    </th>
                                    <th style="font-size: 10px; text-align: center;">
                                        Product Code
                                    </th>
                                    <th style="font-size: 10px; text-align: center; width: 20%;">
                                        Product Name
                                    </th>
                                    <th style="font-size: 10px; text-align: center;">
                                        Product Unit
                                    </th>
                                    <th style="font-size: 10px; text-align: center; width: 20%; ">
                                        Category
                                    </th>
                                    <th style="font-size: 10px; text-align: center; width: 8%; ">
                                        Pack Size
                                    </th>
                                    <th style="font-size: 10px; text-align: center; width: 5%; ">
                                        Rack No.
                                    </th>
                                    <th style="font-size: 10px; text-align: center; width: 6%; ">
                                        Minimum Level
                                    </th>
                                    <th style="font-size: 10px; text-align: center; width: 6%; ">
                                        Total Qty
                                    </th>
                                    <th style="font-size: 10px; text-align: center; width: 5%; ">
                                        Status
                                    </th>
                                    <th style="font-size: 10px; text-align: center; width: 25%; ">
                                        Product Pic.
                                    </th>
                                    <th style="width: 5%; "></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td style="font-size: 11px; width: 100%; display:none;" class="UnitID">
                                            @Html.DisplayFor(modelItem => item.vProductID, new { @id = "vProductID" })
                                        </td>
                                        <td style="font-size: 11px;">
                                            @Html.DisplayFor(modelItem => item.vProductManualCode)
                                        </td>
                                        <td style="font-size: 11px;">
                                            @Html.DisplayFor(modelItem => item.vProductName)
                                        </td>
                                        <td style="font-size: 11px;">
                                            @Html.DisplayFor(modelItem => item.vProductUnit)
                                        </td>
                                        <td style="font-size: 11px;">
                                            @Html.DisplayFor(modelItem => item.vCategoryName)
                                        </td>
                                        <td style="font-size: 11px;">
                                            @Html.DisplayFor(modelItem => item.vPackSize)
                                        </td>
                                        <td style="font-size: 11px;">
                                            @Html.DisplayFor(modelItem => item.vRackSize)
                                        </td>
                                        <td style="font-size: 11px;">
                                            @Html.DisplayFor(modelItem => item.vMinLevel)
                                        </td>
                                        <td style="font-size: 11px;">
                                            @Html.DisplayFor(modelItem => item.vTotalQty)
                                        </td>
                                        <td style="font-size: 11px;">
                                            @Html.DisplayFor(modelItem => item.vStatus)
                                        </td>
                                        <td style="font-size: 11px;">
                                            <img src="@Url.Content(@item.vProductImage)" style="margin:10px; width: 95%;" height="150" id="imagePreview" />
                                        </td>
                                        <td>
                                            <a href="@Url.Action("Create", "ProductInfo", new { productID = @item.vProductAutoID })" class="btn btn-primary"><i class="glyphicon glyphicon-pencil"></i></a>
                                            @*@Html.ActionLink("Edit", "Edit", new { /* id=item.PrimaryKey */ }) |
                                                @Html.ActionLink("Details", "Details", new { /* id=item.PrimaryKey */ }) |
                                                @Html.ActionLink("Delete", "Delete", new { /* id=item.PrimaryKey */ })*@
                                            @*<input type="button" value="Edit" id="btnEdit" class="btnEdit btn btn-primary" />*@
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            $('#ProductTable').DataTable();

            @*$('#UnitTable').on('click', '.btnEdit', function () {
                $.ajax({
                    type: 'GET',
                    url: '@Url.Action("Create", "UnitInformation")',
                    data: { unitID: $(this).parents('tr').find('.UnitID').text() },
                    success: function (response) {
                        window.location.href = '@Url.Action("Create","UnitInformation")';
                    }
                });
            });*@
        });
    </script>
}