@using PosApplication.Models
@model PosApplication.Models.ProductInfoModel

<div style="margin-top: 90px;">
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
        <div class="panel panel-bd lobidisable">
            <div class="panel-heading">
                <div class="panel-title">
                    <h4>Product Information</h4>
                </div>
            </div>
            <div style="height:97%; width:100%; overflow:auto; padding:0; margin:0 auto; margin-left:10px; margin-top:10px;">
                @Html.AntiForgeryToken()
                <input type="button" id="btnFind" value="Find" class="btn btn-primary" />
                <hr />
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" style="margin-top:10px;">
                    <div class="row">
                        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                            <div class="row">
                                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                                    @Html.Label("Product ID:", new { @class = "control-label", @style = "font-size:10px;" })
                                </div>
                                <div class="col-lg-9 col-md-9 col-sm-9 col-xs-9">
                                    @Html.TextBoxFor(model => model.vProductID, new { @class = "form-control", @id = "ProductID", @readonly = "readonly", @style = "background: #fff;" })
                                </div>
                            </div>

                            <div class="row" style="margin-top:5px;">
                                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                                    @Html.Label("Manual Code:", new { @class = "control-label", @style = "font-size:10px;" })
                                </div>
                                <div class="col-lg-9 col-md-9 col-sm-9 col-xs-9">
                                    @Html.TextBoxFor(model => model.vProductManualCode, new { @class = "form-control", @id = "ProductManualCode" })
                                </div>
                            </div>

                            <div class="row" style="margin-top:5px;">
                                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                                    @Html.Label("Product Name:", new { @class = "control-label", @style = "font-size:10px;" })
                                </div>
                                <div class="col-lg-9 col-md-9 col-sm-9 col-xs-9">
                                    @Html.TextBoxFor(model => model.vProductName, new { @class = "form-control", @id = "ProductName" })
                                </div>
                            </div>

                            <div class="row" style="margin-top:5px;">
                                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                                    @Html.Label("Product Unit:", new { @class = "control-label", @style = "font-size:10px;" })
                                </div>
                                <div class="col-lg-9 col-md-9 col-sm-9 col-xs-9">
                                    @Html.DropDownListFor(model => model.vProductUnit, new SelectList(DropDownListModel.GetProductUnit, "Value", "Text", "0"), new { @class = "form-control", @id = "ProductUnitID" })
                                </div>
                            </div>

                            <div class="row" style="margin-top:5px;">
                                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                                    @Html.Label("Category Name:", new { @class = "control-label", @style = "font-size:10px;" })
                                </div>
                                <div class="col-lg-9 col-md-9 col-sm-9 col-xs-9">
                                    @Html.DropDownListFor(model => model.vCategoryID, new SelectList(DropDownListModel.GetCategory, "Value", "Text", "0"), new { @class = "form-control", @id = "CategoryID" })
                                </div>
                            </div>

                            <div class="row" style="margin-top:5px;">
                                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                                    @Html.Label("Pack Size:", new { @class = "control-label", @style = "font-size:10px;" })
                                </div>
                                <div class="col-lg-9 col-md-9 col-sm-9 col-xs-9">
                                    @Html.DropDownListFor(model => model.vPackId, new SelectList(DropDownListModel.GetPackSize, "Value", "Text", "0"), new { @class = "form-control", @id = "PackId" })
                                </div>
                            </div>

                            <div class="row" style="margin-top:5px;">
                                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                                    @Html.Label("Rack Name:", new { @class = "control-label", @style = "font-size:10px;" })
                                </div>
                                <div class="col-lg-9 col-md-9 col-sm-9 col-xs-9">
                                    @Html.DropDownListFor(model => model.vRackId, new SelectList(DropDownListModel.GetRackName, "Value", "Text", "0"), new { @class = "form-control", @id = "RackId" })
                                </div>
                            </div>
                            <div class="row" style="margin-top:5px;">
                                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                                    @Html.Label("Minimum Level:", new { @class = "control-label", @style = "font-size:10px;" })
                                </div>
                                <div class="col-lg-9 col-md-9 col-sm-9 col-xs-9">
                                    @Html.TextBoxFor(model => model.vMinLevel, new { @class = "form-control", @id = "MinLevel" })
                                </div>
                            </div>

                            <div class="row" style="margin-top:5px;">
                                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                                    @Html.Label("Larger Unit Qty:", new { @class = "control-label", @style = "font-size:10px;" })
                                </div>
                                <div class="col-lg-9 col-md-9 col-sm-9 col-xs-9">
                                    @Html.TextBoxFor(model => model.vLargeUnit, new { @class = "form-control", @id = "LargeUnit" })
                                </div>
                            </div>

                            <div class="row" style="margin-top:5px;">
                                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                                    @Html.Label("Small Unit Qty:", new { @class = "control-label", @style = "font-size:10px;" })
                                </div>
                                <div class="col-lg-9 col-md-9 col-sm-9 col-xs-9">
                                    @Html.TextBoxFor(model => model.vSmallUnit, new { @class = "form-control", @id = "SmallUnit" })
                                </div>
                            </div>

                            <div class="row" style="margin-top:5px;">
                                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                                    @Html.Label("Total Qty:", new { @class = "control-label", @style = "font-size:10px;" })
                                </div>
                                <div class="col-lg-9 col-md-9 col-sm-9 col-xs-9">
                                    @Html.TextBoxFor(model => model.vTotalQty, new { @class = "form-control", @id = "TotalQty", @readonly = "readonly", @style = "background:#fff;" })
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                            <div class="row">
                                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                                    @Html.Label("Sales Rate:", new { @class = "control-label", @style = "font-size:10px;" })
                                </div>
                                <div class="col-lg-9 col-md-9 col-sm-9 col-xs-9">
                                    @Html.TextBoxFor(model => model.mSalesRate, new { @class = "form-control", @id = "SalesRate" })
                                </div>
                            </div>

                            <div class="row" style="margin-top:5px;">
                                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                                    @Html.Label("Status:", new { @class = "control-label", @style = "font-size:10px;" })
                                </div>
                                <div class="col-lg-9 col-md-9 col-sm-9 col-xs-9">
                                    @Html.DropDownListFor(model => model.vStatus, new SelectList(DropDownListModel.GetStatus, "Value", "Text", "Active"), new { @class = "form-control", @id = "vStatus" })
                                </div>
                            </div>

                            <div class="row" style="margin-top:5px;">
                                <div class="col-lg-8 col-md-8 col-sm-10 col-xs-10 pull-right">
                                    @Html.Label("Upload Company Logo", new { @class = "control-label", @style = "font-size:10px; width: 100%;" })
                                </div>
                                <div class="col-lg-8 col-md-8 col-sm-10 col-xs-10 pull-right">
                                    <img src="@Url.Content(Model.vProductImage)" style="margin:10px;" height="100" width="100" id="imagePreview" />
                                    <input type="file" id="imagePathName" name="productImageUpload" style="width:220px;" accept="image/bmp, image/jpeg, image/png, image/jpg" onchange="ShowImagePreview(this, document.getElementById('imagePreview'))" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <hr />
                    <div class="row" style="margin-bottom:10px;">
                        <div class="col-lg-4 col-md-4 col-sm-4 col-xs-4"></div>
                        <div class="col-lg-2 col-md-2 col-sm-2 col-xs-2">
                            <input type="button" id="btnSave" value="Save" class="btn btn-success pull-right" style="" />
                        </div>
                        <div class="col-lg-2 col-md-2 col-sm-2 col-xs-2">
                            <input type="button" id="btnReset" value="Reset" class="btn btn-primary pull-left" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@Html.HiddenFor(model => model.vProductAutoID, new { @id = "vProductAutoID" })
@section Scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            $('#ProductManualCode').focus();

            $('#ProductName').keyup(function (event) {
                if (event.keyCode == 13) {
                    if($(this).val().length > 0){
                        $('#CategoryID').focus();
                    }
                }
            });

            $('#btnFind').click(function () {
                window.location.href = '@Url.Action("Index", "ProductInfo")';
            });

            $('#MinLevel').keyup(function (event) {
                if ($(this).val().length > 0) {
                    if (!$.isNumeric($(this).val())) {
                        $(this).val('');
                        $(this).notify('Please enter only numeric value!', 'warn');
                    }
                    else if (event.keyCode == 13) {
                        $(this).val(parseFloat($(this).val()));
                        $('#LargeUnit').focus();
                    }
                }
            });

            $('#LargeUnit').keyup(function (event) {
                if ($(this).val().length > 0) {
                    if (!$.isNumeric($(this).val())) {
                        $(this).val('');
                        $(this).notify('Please enter only numeric value!', 'warn');
                    }
                    else if (event.keyCode == 13) {
                        $(this).val(parseFloat($(this).val()));
                        $('#SmallUnit').focus();
                    }
                    if (!isNaN(parseFloat($('#LargeUnit').val())) && !isNaN(parseFloat($('#SmallUnit').val()))) {
                        $('#TotalQty').attr('readonly', false);
                        $('#TotalQty').val(parseFloat(($('#SmallUnit').val()) * parseFloat($(this).val())).toFixed(2));
                        $('#TotalQty').attr('readonly', 'readonly');
                    }
                }
            });

            $('#SmallUnit').keyup(function () {
                if ($(this).val().length > 0) {
                    if (!$.isNumeric($(this).val())) {
                        $(this).val('');
                        $(this).notify('Please enter only numeric value!', 'warn');
                    }
                    else if (event.keyCode == 13) {
                        $(this).val(parseFloat($(this).val()));
                        $('#SalesRate').focus();
                    }
                    if (!isNaN(parseFloat($('#LargeUnit').val())) && !isNaN(parseFloat($('#SmallUnit').val()))) {
                        $('#TotalQty').attr('readonly', false);
                        $('#TotalQty').val(parseFloat(($('#LargeUnit').val()) * parseFloat($(this).val())).toFixed(2));
                        $('#TotalQty').attr('readonly', 'readonly');
                    }
                }
            });

            $('#SalesRate').keyup(function () {
                if ($(this).val().length > 0) {
                    if (!$.isNumeric($(this).val())) {
                        $(this).val('');
                        $(this).notify('Please enter only numeric value!', 'warn');
                    }
                    else if (event.keyCode == 13) {
                        $(this).val(parseFloat($(this).val()));
                        $('#vStatus').focus();
                    }
                }
            });

            function formCheck() {
                if ($('#ProductManualCode').val()) {
                    if ($('#ProductName').val()) {
                        if ($('#ProductUnitID').val() != "0") {
                            if ($('#CategoryID').val() != "0") {
                                if ($('#PackId').val() != "0") {
                                    if ($('#RackId').val() != "0") {
                                        if ($('#MinLevel').val()) {
                                            if ($('#LargeUnit').val()) {
                                                if ($('#SmallUnit').val()) {
                                                    if ($('#SalesRate').val()) {
                                                        return true;
                                                    }
                                                    else {
                                                        $('#mSalesRate').notify('Please provide sales rate!', 'warn');
                                                        $('#mSalesRate').focus();
                                                        return false;
                                                    }
                                                }
                                                else {
                                                    $('#vSmallUnit').notify('Please provide small unit qty!', 'warn');
                                                    $('#vSmallUnit').focus();
                                                    return false;
                                                }
                                            }
                                            else {
                                                $('#vLargeUnit').notify('Please provide large unit qty!', 'warn');
                                                $('#vLargeUnit').focus();
                                                return false;
                                            }
                                        }
                                        else {
                                            $('#MinLevel').notify('Please provide minimum qty level!', 'warn');
                                            $('#MinLevel').focus();
                                            return false;
                                        }
                                    }
                                    else {
                                        $('#RackId').notify('Please provide rack name!', 'warn');
                                        $('#RackId').focus();
                                        return false;
                                    }
                                }
                                else {
                                    $('#PackId').notify('Please provide pack size!', 'warn');
                                    $('#PackId').focus();
                                    return false;
                                }
                            }
                            else {
                                $('#CategoryID').notify('Please provide category name!', 'warn');
                                $('#CategoryID').focus();
                                return false;
                            }
                        }
                        else {
                            $('#ProductUnitID').notify('Please select product unit!', 'warn');
                            $('#ProductUnitID').focus();
                            return false;
                        }
                    }
                    else {
                        $('#ProductName').notify('Please provide product name!', 'warn');
                        $('#ProductName').focus();
                        return false;
                    }
                }
                else {
                    $('#ProductManualCode').notify('Please provide product manual code!', 'warn');
                    $('#ProductManualCode').focus();
                    return false;
                }
            }

            $('#btnSave').click(function () {
                if (formCheck()) {
                    bootbox.confirm("Do you want to save this information?", function (result) {
                        if (result) {
                            var file = $('#imagePathName').get(0).files;
                            var data = new FormData;
                            data.append('vProductAutoID', $('#vProductAutoID').val());
                            data.append('vProductID', $('#ProductID').val());
                            data.append('vProductManualCode', $('#ProductManualCode').val());
                            data.append('vProductName', $('#ProductName').val());
                            data.append('vProductUnit', $('#ProductUnitID').val());
                            data.append('vCategoryID', $('#CategoryID').val());
                            data.append('vPackId', $('#PackId').val());
                            data.append('vRackId', $('#RackId').val());
                            data.append('vMinLevel', $('#MinLevel').val());
                            data.append('vLargeUnit', $('#LargeUnit').val());
                            data.append('vSmallUnit', $('#SmallUnit').val());
                            data.append('vTotalQty', $('#TotalQty').val());
                            data.append('mSalesRate', $('#SalesRate').val());
                            data.append('vStatus', $('#vStatus').val());
                            data.append('productImageUpload', file[0]);
                            $.ajax({
                                type: 'POST',
                                url: '@Url.Action("Create", "ProductInfo")',
                                data: data,
                                contentType: false,
                                processData: false,
                                success: function (response) {
                                    if (response.success) {
                                        $.notify(response.message, 'success');
                                    }
                                    else {
                                        $.notify(response.message, 'error');
                                    }
                                    window.setTimeout(function () { window.location.href = '@Url.Action("Index", "ProductInfo")' }, 1000);
                                }
                            });
                        }
                    });
                }
            });

            $('#btnReset').click(function () {
                window.location.href = '@Url.Action("Create", "ProductInfo")';
            });
        });
    </script>
}