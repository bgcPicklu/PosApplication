@model PosApplication.Models.ExpenseEntryModel

<div style="margin-top: 90px;">
    <div class="col-xs-12 col-sm-12 col-md-5 col-lg-5" style="margin-bottom:50px !important;">
        <div class="panel panel-bd lobidisable">
            <div class="panel-heading">
                <div class="panel-title">
                    <h4>Expense Entry</h4>
                </div>
            </div>
            <div style="height: 97%; width: 100%; overflow: auto; padding: 0; margin: 0 auto; margin-left: 10px; margin-top: 10px;">
                @Html.AntiForgeryToken()
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                    <label style="font-size: 10px; display:flex;">
                        <label style="margin-top: 5px; width: 120px;">Date : &nbsp;</label>
                        @Html.TextBoxFor(m => m.dDate, new { @class = "form-control", @id = "dDate", @readonly = "readonly", @style = "background: #fff; max-width:150px; font-weight:normal;" })
                    </label>
                </div>

                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                    <label style="font-size: 10px; display:flex;">
                        <label style="margin-top: 5px; width: 120px;">Auto Transaction No. : &nbsp;</label>
                        @Html.TextBoxFor(m => m.vTransactionID, new { @class = "form-control", @id = "vTransactionID", @readonly = "readonly", @style = "background: #fff; max-width:150px; font-weight:normal;" })
                    </label>
                </div>

                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                    <label style="font-size: 10px; display:flex;">
                        <label style="margin-top: 5px; width: 120px;">Transaction No. : &nbsp;</label>
                        @Html.TextBoxFor(m => m.vChallanNo, new { @class = "form-control", @id = "vChallanNo", @style = "max-width:150px; font-weight:normal;" })
                    </label>
                </div>

                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                    <div class="row" style="margin-bottom:10px;">
                        <table class="table table-responsive table-striped table-bordered table-hover table-condensed" id="tbExpenseEntry" style="width: 96%;">
                            <thead style="background: skyblue;">
                                <tr>
                                    <th style="display: none; font-size: 8px;">Account Head ID</th>
                                    <th style="text-align: center; width: 70%; font-size: 8px;">Account Head</th>
                                    <th style="text-align: center; font-size: 8px;">Amount</th>
                                </tr>
                            </thead>
                            <tbody style="height: 220px; overflow: auto;"></tbody>
                        </table>
                    </div>
                </div>

                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                    <div class="row" style="margin-bottom:10px;">
                        <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                        </div>
                        <div class="col-lg-9 col-md-9 col-sm-9 col-xs-9">
                            <input type="button" class="btn btn-primary pull-right" id="btnSave" value="Save" style="margin-right: 25px;" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@Html.HiddenFor(m => m.vTransactionIDAuto, new { @id = "vTransactionIDAuto" })

@section Scripts{
    @Scripts.Render("~/bundles/jqueryval")
    <script type="text/javascript">
        $(document).ready(function () {

            $('#dDate').datepicker({
                dateFormat: 'dd-mm-yy',
                showStatus: true,
                showWeeks: true,
                changeMonth: true,
                changeYear: true,
                showButtionPanel: true,
                highlightWeek: true,
                autoclose: true,
                onSelect: function (dateText) {
                    $(this).change();
                }
            }).on('change', function () {
                $.ajax({
                    url: '@Url.Action("getTransactionNo", "ExpenseEntry")',
                    type: 'GET',
                    data: { dDate: $(this).val() },
                    success: function (data) {
                        $('#vTransactionID').val(data.vTransactionIDAuto);
                    }
                });
            });

            $('#vChallanNo').change(function () {
                $('#tbExpenseEntry tbody').empty();
                var vChallanNo = $(this).val();
                debugger;
                if (vChallanNo != "0")
                {
                    $.ajax({
                        url: '@Url.Action("GetTableData","ExpenseEntry")',
                        type: 'GET',
                        data: { vChallanNo: vChallanNo, dDate: $('#dDate').val(), vTransactionID: $('#vTransactionID').val()},
                        success: function (data) {
                            $.each(data.Tabledata, function (i, value) {
                                $('#dDate').val(value.dDate);
                                $('#vTransactionID').val(value.vTransactionID);
                                $('#vTransactionIDAuto').val(value.vTransactionIDAuto);
                                $('#vChallanNo').val(value.vChallanNo);
                                if ($('#vChallanNo').val() != "")
                                {
                                    $('#tbExpenseEntry tbody').append('<tr class = "mainrow"><td style="display: none; font-size: 12px;" id="vAccountHeadID' + i + '">' + value.vAccountHeadID + '</td>' +
                                            '<td style="text-align: left; font-size: 12px;" id="vAccountHead' + i + '">' + value.vAccountHead + '</td>' +
                                            '<td style="text-align: center; font-size: 12px;" class="Delete"><input type="text" style="width: 100%; text-align: right;" value = ' + (isNaN(parseFloat(value.nAmount)) ? '' : value.nAmount) + ' id = "txtAmount' + i + '" style="max-width:70px; text-align:right;" class="form-control" /></td></tr>');
                                }
                            });
                        }
                    });
                }
            });

            var lstValues = [];
            $('#btnSave').click(function () {
                //if (formCheck())
                //{
                bootbox.confirm("Do you want to save this information?", function (result) {
                    if (result) {
                        var Amount = 0;
                        $('#tbExpenseEntry tbody').find('tr').each(function (i, value) {
                            Amount = 0;
                            if (parseFloat($('#txtAmount' + i).val()) > 0) {
                                lstValues.push({
                                    dDate: $('#dDate').val(),
                                    vTransactionID: $('#vTransactionID').val(),
                                    vChallanNo: $('#vChallanNo').val(),
                                    vAccountHeadID: $('#vAccountHeadID' + i).text(),
                                    vAccountHead: $('#vAccountHead' + i).text(),
                                    nAmount: $('#txtAmount' + i).val()
                                });
                            }
                        });
                        debugger;
                        $.ajax({
                            url: '@Url.Action("Create","ExpenseEntry")',
                            type: "POST",
                            data: JSON.stringify({ vTransactionIDAuto: $('#vTransactionIDAuto').val(),lstExpenseEntry: lstValues }),
                            dataType: "JSON",
                            contentType: 'application/json',
                            success: function (data) {
                                if (data.success) {
                                    $.notify(data.message, "success");
                                    window.setTimeout(function () { window.location.href = '@Url.Action("Create", "ExpenseEntry")' }, 1000);
                                }
                                else
                                    $(data.message, "error");
                            }
                        });
                    }
                });
                //}
            });
        });
    </script>
}
